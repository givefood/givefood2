// See PLAN.md §3.4. D1/KV/R2 resources are provisioned (2026-08-30) --
// see the comments next to each binding for what's real vs a name that
// will auto-create on first Worker deploy (R2 buckets need creating
// explicitly; Analytics Engine datasets do not).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "givefood2",
  "main": "./src/index.ts",

  // Cloudflare Workers Builds (the git-integration CI/CD) runs a FIXED
  // "npx wrangler deploy" -- it does not go through this package's own
  // package.json scripts at all, so a precompile step prefixed onto an npm
  // script (as workers/site/package.json's dev/deploy used to do) silently
  // never runs there. This hook is wrangler's own mechanism for exactly
  // that gap: it always runs first, regardless of how wrangler was invoked
  // (a bare `wrangler deploy`, `npx wrangler deploy`, an npm script, CI).
  // packages/templates/src/generated/precompiled.js is gitignored
  // (generated, not committed -- see that package's .gitignore entry), so
  // without this the build step fails to resolve it. See PLAN.md §6.2.3.
  "build": {
    "command": "pnpm --filter @givefood/templates run precompile",
    // ONLY the .njk/.po source -- not packages/templates/src, which is
    // where the command's own output (src/generated/) lands. Watching that
    // too makes every run of the command trigger the watcher, which
    // reruns the command, forever (found by testing this exact config in
    // wrangler dev). workers/site's own src/ needs no entry here:
    // wrangler's bundler already watches every file in the Worker's real
    // import graph (including packages/templates/src/*.ts) independently
    // of this -- watch_dir only scopes when to rerun the custom build
    // command above, and only .njk/.po files affect what it produces.
    "watch_dir": ["../../packages/templates/templates", "../../packages/templates/locale"]
  },

  // >= 2026-08-04 turns on nodejs_compat and nodejs_compat_v2 with no flag.
  // >= 2026-07-21 is required for the Workers Cache API used below.
  "compatibility_date": "2026-08-28",

  // beta.givefood.org.uk was attached as a Custom Domain through the
  // dashboard and went undeclared here for days. Every `wrangler deploy`
  // therefore printed it under a "local config differs from remote"
  // warning as a REMOVAL -- and since a deploy overrides remote config
  // with local, the only reason beta survived each one is that Cloudflare
  // keeps the domain attachment as its own resource. Declaring it closes
  // that gap rather than relying on that continuing to be true.
  //
  // A Custom Domain, NOT a pattern route: it takes every request for the
  // hostname, so there is no "/*" and no zone_name. Wrangler's
  // CustomDomainRoute schema is additionalProperties:false and accepts
  // only pattern/custom_domain/enabled/previews_enabled -- the zone_name
  // Cloudflare reports back for it is not a settable input. enabled and
  // previews_enabled are pinned to what the remote already had, so this
  // declaration is a no-op against live rather than a change.
  "routes": [
    { "pattern": "beta.givefood.org.uk", "custom_domain": true, "enabled": true, "previews_enabled": false }
  ],

  // Production, at cutover. ONE entry, so most-specific-wins never has to be
  // reasoned about.
  //
  // DISABLED ON PURPOSE. givefood.org.uk is the LIVE production zone, and
  // this takes the whole hostname the moment a deploy lands with it active.
  // Until cutover, deploys serve only from the beta custom domain above and
  // <name>.<subdomain>.workers.dev (workers_dev, on by default). This entry
  // joins the "routes" array above when it happens.
  //   { "pattern": "www.givefood.org.uk", "custom_domain": true }
  //
  // A CUSTOM DOMAIN, NOT the `www.givefood.org.uk/*` pattern route this used
  // to say. Cloudflare documents error 9403 for "Workers scoped to the entire
  // domain /*" and error 9524 for "an image URL is intercepted by a Worker",
  // giving "use a Custom Domain instead" as the workaround for the latter --
  // and routes/media.ts's `?s=` resizing makes a `cf.image` subrequest back to
  // this same hostname, which is exactly the shape 9403 describes. That
  // subrequest carries its own recursion guard so it does not depend on the
  // topology, but there is no reason to pick the shape Cloudflare warns about
  // when the one it recommends is what beta already runs. See
  // givefood/givefood2#2.

  // Cloudflare Images transform binding. routes/media.ts uses it to answer
  // `?s=<width>` on the photo routes -- see that file for the URL contract
  // and for why the templates no longer go through `/cdn-cgi/image/`.
  // routes/wfbn/screenshot.ts. "remote": true because Browser Rendering has
  // no local simulation -- `wrangler dev` would otherwise fail on the
  // binding rather than take a screenshot.
  "browser": { "binding": "BROWSER", "remote": true },

  "images": { "binding": "IMAGES" },

  // Workers Cache. NOT optional on a catch-all route -- see PLAN.md §3.6.
  // Tiered, collapses concurrent misses, and serves hits WITHOUT
  // executing the Worker (so a hit costs 0 CPU-ms).
  "cache": { "enabled": true },

  "assets": {
    "directory": "./dist/static",
    "binding": "ASSETS",
    // BOTH "none" deliberately. The router owns trailing-slash policy
    // (Django's APPEND_SLASH). Letting the asset layer emit its own 301s
    // would fight the router and produce redirect chains across 3,000+
    // food bank URLs. "force-trailing-slash" only affects ASSET lookups
    // anyway -- it will look like it works on /static/ and do nothing else.
    "html_handling": "none",
    "not_found_handling": "none"
  },

  "d1_databases": [
    // Pre-existing, empty (0 tables) -- created 2023-08-04, reused rather
    // than creating a duplicate. Real data migration (PLAN.md §5) still has
    // to populate it.
    //
    // READ REPLICATION IS ENABLED on this database (confirmed 2026-08-30).
    // Once packages/db exists, every query MUST go through the D1 Sessions
    // API (env.DB.withSession(), propagating the bookmark) rather than
    // calling env.DB.prepare() on this binding directly, or reads can land
    // on a replica that hasn't caught up with a just-completed write.
    // https://developers.cloudflare.com/d1/best-practices/read-replication/#use-sessions-api
    {
      "binding": "DB", "database_name": "givefood", "database_id": "1cae445f-9719-453d-9cf6-1060f8b3ea7e",
      // Shared with workers/jobs -- lives in packages/db, not duplicated per-Worker.
      "migrations_dir": "../../packages/db/migrations"
    }
  ],

  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "givefood-media" },
    { "binding": "GEO",   "bucket_name": "givefood-geo"   },
    // Pre-existing, empty bucket (created 2025-04-24), reused rather than
    // creating a duplicate. img/ar/** and img/appscreenshots/** -- see
    // routes/staticMedia.ts and PLAN.md WP 1.6.
    { "binding": "STATIC_MEDIA", "bucket_name": "givefood-static" }
  ],

  "kv_namespaces": [
    { "binding": "SESSIONS", "id": "578ca791bd1d4cba8b5935f9e5f70438" },
    { "binding": "DATA",     "id": "c7dbe1c5cbe542efb91364675e081944" }
  ],

  "analytics_engine_datasets": [
    { "binding": "HITS", "dataset": "foodbank_hits" }
  ],

  "queues": {
    "producers": [
      { "queue": "cache-purge",    "binding": "PURGE_Q"    },
      { "queue": "jobs",           "binding": "JOBS_Q"     },
      // WP 4.8: routes/whatsappHook.ts enqueues a verified inbound message
      // here and returns 200 immediately -- no consumer declared anywhere
      // yet. Command processing (subscribe/unsubscribe, which needs a D1
      // whatsappsubscriber table that doesn't exist yet, and the outbound
      // WHATSAPP_TOKEN send capability, which lives only on givefood2-jobs)
      // is Phase 5 work; messages simply queue up until that consumer is
      // built, same as Cloudflare Queues' normal producer-before-consumer
      // support.
      { "queue": "whatsapp-hook",  "binding": "WHATSAPP_Q" },
      // Admin-triggered single-foodbank "Force Check"/"Force Article
      // Crawl"/"Force Charity Crawl" (foodbank_detail.njk): the SAME
      // queues givefood2-jobs's own cron fan-out (scheduled/index.ts)
      // already produces to and consumes from, just with an admin-built
      // one-row CrawlSet instead of the cron's whole-table one. Multiple
      // Workers can bind as producers to the same queue; the consumer
      // binding (and all four handler code) stays on givefood2-jobs only,
      // matching this codebase's Worker isolation rule -- this Worker
      // never imports workers/jobs/src, it only enqueues onto queues that
      // already exist.
      { "queue": "needcheck-render", "binding": "RENDER_Q" },
      { "queue": "articles",         "binding": "ARTICLES_Q" },
      { "queue": "charity-ew",       "binding": "CHARITY_EW_Q" },
      { "queue": "charity-scotland", "binding": "CHARITY_SCOTLAND_Q" },
      { "queue": "charity-ni",       "binding": "CHARITY_NI_Q" }
    ]
  },

  "vars": {
    "SITE_DOMAIN": "https://www.givefood.org.uk",
    "GOOGLE_OAUTH_CLIENT_ID": "927281004707-tboi1tsphl4bgtqn72e76rmc7r2q22tk.apps.googleusercontent.com",
    "TURNSTILE_SITEKEY": "0x4AAAAAAABxtIRWlPcEGwhj",
    // Admin footer only -- the D1 equivalent of Django's DB_HOST, which its
    // own admin footer shows so an admin with a local and a production tab
    // open can tell them apart. The binding exposes no name at runtime.
    "D1_DATABASE_NAME": "givefood"
  },

  // PLAN.md §6507 names this as the replacement for Django's
  // `os.environ['SOURCE_COMMIT'][:7]`, which supplies BOTH the admin footer's
  // "Version" and every `?v=` static cache-buster in the page shell. Without
  // it packages/templates/src/context.ts falls back to the literal string
  // "dev", so every deploy re-served stale CSS/JS under the same ?v=dev.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },

  // Declares required secret NAMES so `wrangler dev` and deploy both
  // fail loudly if one is missing. Values are set with `wrangler secret put`.
  // "required" was front-loaded from PLAN.md §3.3's full binding map before
  // any code that reads these existed -- that made `wrangler deploy` a hard
  // failure for the media-route slice this pass actually built, which
  // touches none of them. Move a name back into this list (and set the
  // real value with `wrangler secret put NAME`) as soon as the code for
  // that phase lands and genuinely reads it, not before. Do not fetch these
  // from GfCredential in the Django database and paste them in here without
  // asking first -- several are live production credentials.
  "secrets": {
    // GMAP_GEOCODE_KEY: lib/geocode.ts (the four */search/?address=
    // endpoints, WP 2.4 follow-up). Set 2026-08-30.
    // VAPID_PUBLIC_KEY: routes/wfbn/webpush.ts's wfbnWebpushConfig.
    // TURNSTILE_SECRET: routes/wfbn/updates.ts's subscribe action (siteverify).
    // POSTMARK_TOKEN: routes/wfbn/updates.ts's confirm/confirmed email sends.
    // SUBSCRIBER_SALT: routes/wfbn/updates.ts's sub_key/unsub_key generation.
    // All four added by WP 3.7, set 2026-08-31 (confirmed via `wrangler
    // secret list`) -- safe to list as required now.
    // CSRF_SECRET: lib/csrf.ts's signed double-submit token (routes/write/*,
    // WP 4.6 R3). Set 2026-09-01, confirmed via `wrangler secret list`.
    //
    // WHATSAPP_WEBHOOKVERIFYTOKEN, WHATSAPP_APP_SECRET: routes/whatsappHook.ts's
    // GET verification and POST signature check (WP 4.8). Set 2026-09-01,
    // confirmed via `wrangler secret list`.
    //
    // "required" is enforced for real by `wrangler deploy` (not just
    // `wrangler dev`) -- confirmed the hard way earlier the same day:
    // listing a name here before actually running `wrangler secret put`
    // for it made Cloudflare Workers Builds fail outright ("The following
    // required secrets have not been set"), blocking every deploy from
    // main until reverted. `wrangler deploy --dry-run` does NOT perform
    // this check, so it looks safe locally when it isn't. Move a name
    // into "required" only in the same change that actually sets it.
    // GOOGLE_OAUTH_CLIENT_SECRET, SESSION_HMAC_KEY: lib/adminAuth.ts (WP
    // 6.1/6.2) -- the admin's Authorization Code + PKCE sign-in. Django's
    // own GSI-button flow never needed a client secret at all (client-side
    // ID token, no server-to-server exchange -- confirmed absent anywhere
    // in gfauth/, verified by grep), so this is genuinely new, not carried
    // over. GOOGLE_OAUTH_CLIENT_SECRET is real Google Cloud Console data
    // for the existing OAuth client (927281004707-...apps.googleusercontent
    // .com); SESSION_HMAC_KEY is self-generated (any random 32+ byte
    // value, this Worker invents it, no external source). Both set
    // 2026-09-02, confirmed via `wrangler secret list`.
    //
    // MAPIT_KEY: routes/admin/foodbankLocationArea.ts's "New Location
    // Area" form (mapit.mysociety.org's area/geometry + area.geojson
    // calls). Already named in PLAN.md §10.2.7's own secrets table. Set
    // 2026-09-02, confirmed via `wrangler secret list`.
    //
    // GMAP_PLACES_KEY / GMAP_STATIC_KEY: this Worker DOES call Google
    // directly, which the note below this list used to deny -- that claim
    // predated the admin port. routes/admin/gmapProxy.ts is the CORS shim
    // behind admin.js's "Lookup Location" / "Lookup Donation Point"
    // buttons and injects GMAP_PLACES_KEY server-side (deliberately: unlike
    // Django, the Places key never reaches the browser). GMAP_STATIC_KEY is
    // published to the admin page for admin.js's staticmap <img>, which is
    // a browser-side URL by construction. Both set 2026-09-02, confirmed
    // via `wrangler secret list`.
    //
    // CF_API_KEY / CF_ZONE_ID: routes/admin/clearCache.ts's zone purge --
    // the Settings page's "Clear Cache" button. The token needs Zone.Cache
    // Purge on givefood.org.uk. Set 2026-09-02, confirmed via `wrangler
    // secret list`. Until they were set the handler degraded to a KV-only
    // purge with a warning banner; that branch stays, since it is also what
    // a revoked token should do.
    "required": [
      "GMAP_GEOCODE_KEY",
      "VAPID_PUBLIC_KEY",
      "TURNSTILE_SECRET",
      "POSTMARK_TOKEN",
      "SUBSCRIBER_SALT",
      "CSRF_SECRET",
      "WHATSAPP_WEBHOOKVERIFYTOKEN",
      "WHATSAPP_APP_SECRET",
      "GOOGLE_OAUTH_CLIENT_SECRET",
      "SESSION_HMAC_KEY",
      "MAPIT_KEY",
      "GMAP_PLACES_KEY",
      "GMAP_STATIC_KEY",
      "CF_API_KEY",
      "CF_ZONE_ID"
    ]
    // workers/jobs/wrangler.jsonc has its OWN GMAP_STATIC_KEY, for the
    // queued media backfill (§3.7). Two Workers, two copies of the same
    // value -- that is how Worker secrets work; neither is the other's.
  },

  "observability": { "enabled": true, "head_sampling_rate": 1 },

  // 30s is ample: HTML rendering is I/O-bound and waiting on D1 does not
  // count toward CPU. Raise only if a gfdash aggregation says otherwise.
  "limits": { "cpu_ms": 30000 },

  // Smart Placement pins compute near a latency-bound origin. There isn't
  // one here -- every binding is D1/R2/KV, not a single-region Postgres --
  // so this is skipped. (No Hyperdrive-behind-Postgres interim at any
  // point; see PLAN.md §4, §6 D3.)

  "preview_urls": true,

  "tail_consumers": []
}
