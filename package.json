{
  "name": "givefood",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:site": "pnpm --filter @givefood/site dev",
    "dev:jobs": "pnpm --filter @givefood/jobs dev",
    "typecheck": "pnpm -r typecheck",
    "verify:webpush": "packages/templates/node_modules/.bin/tsx tools/webpush-vector/verify.ts",
    "verify:whatsapp": "packages/templates/node_modules/.bin/tsx tools/whatsapp-command/verify.ts",
    "test": "pnpm -r test",
    "verify:cache-headers": "packages/templates/node_modules/.bin/tsx workers/site/tools/cache-headers/verify.ts"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "wrangler": "^4.127.1"
  }
}
