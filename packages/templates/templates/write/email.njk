{% extends "page.njk" %}

{% block head %}
  <link rel="stylesheet" href="/static/css/wfbn.css?v={{ version }}">
  <meta name="twitter:card" content="summary">
  <meta name="twitter:site" content="@GiveFoodCharity">
  <meta property="og:title" content="Constituencies">
  <meta name="description" content="Find what food banks in your MP's constituency are requesting to have donated and take action.">
  <meta property="og:image" content="https://www.givefood.org.uk/static/img/map.png">
  <meta property="og:image:alt" content="Map of UK food banks">
{% endblock %}

{% block title %}Write your email - Give Food{% endblock %}

{% block body %}

  <div class="columns">
    <div class="column">

      <div class="columns">

        <div class="column is-4">
          <a href="{{ url('index') }}" class="logo"><img src="/static/img/logo.svg" alt="Give Food"></a>
        </div>

      </div>

      <nav class="breadcrumb has-arrow-separator" aria-label="breadcrumbs">
            <ul>
                <li><a href="{{ url('index') }}">Home</a></li>
                <li><a href="{{ url('write:index') }}">Write to your MP</a></li>
                <li><a href="{{ url('write:constituency', constituency.slug) }}">{{ constituency.name }}</a></li>
            </ul>
      </nav>

      <h1>{{ constituency.name }}</h1>

      <div class="columns">

          <div class="column is-4">

            <div class="content">
                <ul>
                    <li>Be polite</li>
                    <li>Feel free to edit the subject &amp; email body</li>
                    <li>We'll send this on your behalf, but the MP will be able to reply to you directly</li>
                </ul>
            </div>

          </div>

          <div class="column is-6">

            {% if turnstilefail %}
              <div class="notification is-danger">
                <p>Sorry, the security check failed. Please try again.</p>
              </div>
            {% endif %}
            {% if send_failed %}
              <div class="notification is-danger">
                <p>Sorry, we weren't able to send that email. Please try again.</p>
              </div>
            {% endif %}

            <form method="post" action="{{ url('write:send', constituency.slug) }}">

              <div class="field">
                <label class="label" for="id_from_field">From</label>
                <div class="control">
                  <input type="text" name="from_field" maxlength="200" class="input" id="id_from_field" value="{{ from_field }}" readonly>
                </div>
              </div>
              <input type="hidden" name="from_name" value="{{ from_name }}">
              <input type="hidden" name="from_email" value="{{ from_email }}">

              <div class="field">
                <label class="label" for="id_to_field">To</label>
                <div class="control">
                  <input type="text" name="to_field" maxlength="200" class="input" id="id_to_field" value="{{ to_field }}" readonly>
                </div>
              </div>

              <div class="field">
                <label class="label" for="id_subject">Subject</label>
                <div class="control">
                  <input type="text" name="subject" maxlength="200" class="input" id="id_subject" value="{{ subject }}" required>
                </div>
              </div>

              <div class="field">
                <label class="label" for="id_body">Email</label>
                <div class="control">
                  <textarea name="body" cols="40" rows="20" class="textarea" id="id_body" required>{{ body }}</textarea>
                </div>
              </div>

              <div class="cf-turnstile" data-sitekey="{{ turnstile_sitekey }}"></div>
              <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

              <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
              <input type="submit" class="button is-link" value="Send Email">

            </form>

          </div>
      </div>

    </div>
  </div>

{% endblock %}
