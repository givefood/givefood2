{% extends "page.njk" %}

{% block title %}{{ _("403 - Forbidden") }} - Give Food{% endblock %}

{% block body %}

  <div class="columns">
    <div class="column">

      <div class="columns">

        <div class="column is-4">
          <a href="{{ url('index') }}" class="logo"><img src="/static/img/logo.svg" alt="Give Food"></a>
        </div>

      </div>

      <h1>{{ _("403 - Forbidden") }}</h1>

      <div class="columns">

          <div class="column">

            <p>{{ _("Sorry, something has gone wrong there and we can't serve that page. This error has been logged and we'll look into it.") }}</p>

            <ul>
                <li><a href="/">{{ _("Homepage") }}</a></li>
                <li><a href="/needs/">{{ _("Find what food banks need") }}</a></li>
                <li>{{ _("Email") }} <a href="mailto:mail@givefood.org.uk">mail@givefood.org.uk</a></li>
            </ul>

          </div>
      </div>

    </div>
  </div>

{% endblock %}
