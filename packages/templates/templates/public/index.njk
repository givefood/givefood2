{% extends "page.njk" %}

{% block head %}
  <link rel="stylesheet" href="/static/css/hp.css?v={{ version }}">
  <link rel="stylesheet" href="/static/css/autocomplete.css?v={{ version }}">
  <link rel="alternate" type="text/markdown" href="{{ url('md_index') }}">
  <meta name="description" content="{% blocktrans %}Give Food a UK charity uses data to highlight local and structural food insecurity then provides tools to help alleviate it.{% endblocktrans %}">
  <link rel="alternate" type="application/rss+xml" title="Give Food RSS" href="{{ url('wfbn:rss') }}">
  <meta name="twitter:card" content="summary">
  <meta name="twitter:site" content="@GiveFoodCharity">
  <meta property="og:title" content="Give Food">
  <meta property="og:description" content="{% blocktrans %}We're a UK charity that uses data to highlight local and structural food insecurity then provides tools to help alleviate it.{% endblocktrans %}">
  <meta property="og:image" content="https://www.givefood.org.uk/static/img/map.png">
  <meta property="og:image:alt" content="Map of UK food banks">
{% endblock %}

{% block title %}Give Food{% endblock %}

{% block body %}

  <div class="columns">
    <div class="column">
      <a href="{{ url('index') }}" class="logo"><img src="/static/img/logo.svg" alt="Give Food"></a>
      {% include "includes/langswitcher.njk" %}
    </div>
  </div>

    {# `locations` is never set by the homepage route -- Django's index()
       view doesn't pass it either, so this `{% if locations %}` is always
       false in production too and both columns are always is-half. Kept
       as a straight port rather than collapsed to a flat class, in case a
       future change (e.g. an inline nearby-locations widget) starts
       setting it. #}
    <div class="columns">
    <div class="column {% if locations %}is-three-fifths{% else %}is-half{% endif %}" role="main">

      <p>{% blocktrans %}We're a UK charity that uses data to highlight local and structural food insecurity then provides tools to help alleviate it.{% endblocktrans %}</p>
      <p>{% blocktrans %}Use our unique database to find a food bank near you, see what they need and how you can help by donating or volunteering.{% endblocktrans %}</p>

      <a id="usemylocationbtn" href="{{ url('wfbn:get_location') }}" class="button is-light is-info" data-url="{{ url('wfbn:index') }}" data-no-instant>{% blocktrans %}Use my location{% endblocktrans %}</a>
      <form id="addressform" action="{{ url('wfbn:index') }}" method="GET">
        <label id="address_label" for="address_field" class="label">{% blocktrans %}Postcode or town{% endblocktrans %}</label>
        <input id="address_field" type="text" name="address" class="input" placeholder="{% blocktrans %}e.g. EX4 6PX or Sheffield{% endblocktrans %}" value="{{ address }}" required>
        <input id="lat_lng_field" type="hidden" name="lat_lng">
        <input type="submit" class="button is-light is-info" value="{{ _("Go") }}">
      </form>

      <div id="index-intro">

        <ul>
            {% if enable_write %}
              <li><a href="{{ url('write:index') }}">{{ _("Write to your MP") }}</a>{% if language_code != 'en' %} ({{ _("English") }}){% endif %}</li>
            {% endif %}
            <li><a href="{{ url('donate') }}">{{ _("Donate") }}</a></li>
            <li><a href="{{ url('register_foodbank') }}">{% blocktrans %}Register a foodbank{% endblocktrans %}</a></li>
            <li><a href="{{ url('about_us') }}">{% blocktrans %}About us{% endblocktrans %}</a></li>
        </ul>

        <h2>{% blocktrans %}Recently updated{% endblocktrans %}</h2>
        <ul class="recently-updated">
            {% for foodbank in recently_updated %}
                <li><a href="{{ url('wfbn:foodbank', foodbank.slug) }}">{{ foodbank.name }}</a></li>
            {% endfor %}
        </ul>

        <h2>{% blocktrans %}Most viewed this week{% endblocktrans %}</h2>
        <ul class="most-viewed">
            {% for foodbank in most_viewed %}
                <li><a href="{{ url('wfbn:foodbank', foodbank.slug) }}">{{ foodbank.name }}</a></li>
            {% endfor %}
        </ul>

        <h2>{% blocktrans %}News from food banks{% endblocktrans %}</h2>
        {% include "public/frags/news.njk" %}

        <a href="{{ url('news') }}" class="all-news">{{ _("All news") }}&nbsp;<svg viewBox="0 0 10 10" fill="none" aria-hidden="true"><path d="M1 1l4 4-4 4"></path></svg></a>

      </div>

    </div>

    <div class="column {% if locations %}is-two-fifths{% else %}is-half{% endif %}">
      <div id="map"></div>
      {% include "includes/maplegend.njk" %}
    </div>

  </div>

</div>

<div class="logos-container">
  <div class="container">
    <div class="columns">
      <div class="column">
        <h2>{{ _("We've worked with") }}</h2>
      </div>
    </div>

    <div class="columns logos is-mobile is-multiline">
      {% for logo in logos %}
        <div class="column is-half-mobile is-one-third-tablet is-2-desktop">
          <a href="{{ logo.url }}">
            <img src="/static/img/hplogos/{{ logo.slug }}.{{ logo.format }}" class="{{ logo.slug }}" alt="{{ logo.name }}" loading="lazy">
          </a>
        </div>
      {% endfor %}
    </div>

  </div>
</div>

<div class="container how-help-container">

  <div class="columns">
    <div class="column how-help">
      <h2>{{ _("How we can help") }}</h2>
    </div>
  </div>

  <div class="columns how-help-cat">
    <div class="column">
      <h3>{{ _("Public") }}</h3>
      <p>{{ _("Use our tool to find your local food banks, then donate, volunteer or take political action.") }}</p>
      <a href="#top">{{ _("Find out how to help") }}&nbsp;<svg viewBox="0 0 10 10" fill="none" aria-hidden="true"><path d="M1 1l4 4-4 4"></path></svg></a>
    </div>
    <div class="column">
      <h3>{{ _("Food banks") }}</h3>
      <p>{{ _("Register a food bank to be included in our database and allow users to find you and what you need.") }}</p>
      <a href="{{ url('register_foodbank') }}">{{ _("Register a food bank") }}&nbsp;<svg viewBox="0 0 10 10" fill="none" aria-hidden="true"><path d="M1 1l4 4-4 4"></path></svg></a>
    </div>
    <div class="column">
      <h3>{{ _("Media") }}</h3>
      <p>{{ _("Journalists, in particular data journalists, can use our data for stories around food poverty.") }}</p>
      <a href="/api/">{{ _("Use our API") }}&nbsp;<svg viewBox="0 0 10 10" fill="none" aria-hidden="true"><path d="M1 1l4 4-4 4"></path></svg></a>
    </div>
    <div class="column">
      <h3>{{ _("Researchers & students") }}</h3>
      <p>{{ _("We can provide our data in bulk, plus advice on how to interpret it, to researchers. Have a look at our API or email us.") }}</p>
      <a href="/api/">{{ _("Use our API") }}&nbsp;<svg viewBox="0 0 10 10" fill="none" aria-hidden="true"><path d="M1 1l4 4-4 4"></path></svg></a>
    </div>
  </div>

  <div class="columns">
    <div class="column">
      <h2>{{ _("Countries") }}</h2>
    </div>
  </div>

  <div class="columns countries">
      <div class="column">
        <a href="{{ url('country', 'england') }}" class="england"><img src="/static/img/countries/england.svg" alt="England"> England</a>
      </div>
      <div class="column">
        <a href="{{ url('country', 'scotland') }}" class="scotland"><img src="/static/img/countries/scotland.svg" alt="Scotland"> Scotland</a>
      </div>
      <div class="column">
        <a href="{{ url('country', 'wales') }}" class="wales"><img src="/static/img/countries/wales.svg" alt="Wales"> Wales</a>
      </div>
      <div class="column">
        <a href="{{ url('country', 'northern-ireland') }}" class="northern-ireland"><img src="/static/img/countries/northern-ireland.svg" alt="Northern Ireland"> Northern Ireland</a>
      </div>
  </div>

  <div class="columns">
    <div class="column">
      <h2>{{ _("Statistics") }}</h2>
    </div>
  </div>

  <div class="columns stats">
      <div class="column">
        <h3>📍&ensp;{{ _("Food banks") }}</h3>
        <p>{{ stats.foodbanks|intcomma }}</p>
      </div>
      <div class="column">
        <h3>🛒&ensp;{{ _("Donation points") }}</h3>
        <p>{{ stats.donationpoints|intcomma }}</p>
      </div>
      <div class="column">
        <h3>🥫&ensp;{{ _("Items requested") }}</h3>
        <p>{{ stats.items|intcomma }}</p>
      </div>
      <div class="column">
        <h3>🥣&ensp;{{ _("Meals delivered") }}</h3>
        <p>{{ stats.meals|intcomma }}</p>
      </div>
      <div class="column">
        <h3>📅&ensp;{{ _("Last updated") }}</h3>
        <p data-include="{{ url('frag', 'last-updated') }}"></p>
      </div>
  </div>

</div>

<div class="container">

  <div class="columns is-centered">
    <div class="column is-three-quarters">
      <p class="annualreportteaser">
        {{ _("Read our") }} <a href="{{ url('annual_report', '2025') }}">2025 {{ _("annual report") }}</a>
      </p>
    </div>
  </div>


{% endblock %}


{% block script %}

  {% include "includes/mapconfig.njk" %}
  <script src="/static/js/autocomplete.js?v={{ version }}" defer></script>
  <script src="/static/js/wfbn.js?v={{ version }}" defer onload="init()"></script>

{% endblock %}
