{# gfauth/templates/auth/sign_in.html:1 extends "public/page.html", NOT
   admin/page.html -- /auth/ (gfauth/urls.py) is registered outside
   gfadmin entirely and sits outside i18n_patterns too (givefood/urls.py:92-103),
   so Django renders it with the public site's chrome (public footer,
   Plausible/GTM, no admin nav) rather than the admin navbar an
   unauthenticated visitor has no business seeing anyway. Was wrongly
   extending admin/page.njk here, which drew the full Food
   Banks/Locations/.../Settings navbar (and its search box) on a page
   nobody is signed in to see it from. #}
{% extends "page.njk" %}

{# sign_in.html has no {% block title %} override of its own, so Django
   renders a literally empty <title></title> on this page -- kept as-is
   rather than "fixed" with a title, same philosophy as WP 6.12's other
   kept-not-fixed Django quirks. #}

{# /auth/ is admin-only traffic -- keep it out of fivebar. #}
{% block tally %}{% endblock %}

{% block body %}
<div class="columns is-centered">
  <div class="column is-one-quarter" style="margin-top:50px">
    {% if admin_user %}
    <div>
      {% if admin_user.picture %}<img src="{{ admin_user.picture }}" alt="User picture">{% endif %}
      <p>
        <strong>{{ admin_user.givenName }}</strong>
        <br>{{ admin_user.email }}
      </p>
      <p><a href="/admin/">Admin</a></p>
      <p><a href="/auth/sign-out/">Sign out</a></p>
    </div>
    {% else %}
    <div>
      {# routes/admin/auth.ts:adminAuthStart -- the actual click that talks
         to Google. Split out of this page's own route 2026-09-03: that
         route used to auto-redirect to Google itself whenever `next` was
         present, which meant landing here from requireAdminAuth's gate
         (always carrying a next) skipped this page and this click
         entirely -- Google's own still-active session then signed the
         admin straight back in with no explicit action, making Sign Out
         look broken. #}
      <a href="/auth/start/?next={{ next | urlencode }}" class="button is-link">Sign in with Google</a>
    </div>
    {% endif %}
  </div>
</div>
{% endblock %}
