{# gfadmin/views.py foodbank_subscribers_tab -- lazy-loaded fragment. #}
<dl>
  <dt><span class="mdi mdi-email"></span> Email</dt>
  <dd>{{ subscribers.subscription_counts.email }}</dd>
  <dt><span class="mdi mdi-whatsapp"></span> WhatsApp</dt>
  <dd>{{ subscribers.subscription_counts.whatsapp }}</dd>
  <dt><span class="mdi mdi-cellphone"></span> Mobile</dt>
  <dd>{{ subscribers.subscription_counts.mobile }}</dd>
  <dt><span class="mdi mdi-bell"></span> Web Push</dt>
  <dd>{{ subscribers.subscription_counts.webpush }}</dd>
</dl>

<h3 class="title is-5">All Subscriptions</h3>
<table class="table is-fullwidth is-hoverable">
  <thead>
    <tr><th>Type</th><th>Identifier</th><th>Created</th></tr>
  </thead>
  <tbody>
    {% for s in subscribers.all_subscriptions %}
    <tr>
      <td style="white-space:nowrap">{{ s.type_emoji | safe }} {{ s.type | django_title }}</td>
      <td>{{ s.identifier }}</td>
      <td>{{ s.created }}</td>
    </tr>
    {% else %}
    <tr><td colspan="3">None</td></tr>
    {% endfor %}
  </tbody>
</table>
