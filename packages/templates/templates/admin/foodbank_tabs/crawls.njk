{# gfadmin/views.py foodbank_crawls_tab -- lazy-loaded fragment. #}
<table class="table is-fullwidth">
  <tbody>
    {% for item in crawl_items %}
    <tr>
      <td>{{ item.crawl_type }}</td>
      <td>{{ item.start }}</td>
      <td>{% if item.finish %}Finished{% else %}Running{% endif %}</td>
      <td>{% if item.url %}<a href="{{ item.url }}">{{ item.url | truncatechars(40) }}</a>{% endif %}</td>
    </tr>
    {% else %}
    <tr><td colspan="4">None</td></tr>
    {% endfor %}
  </tbody>
</table>
