{% extends "admin/page.njk" %}

{% block title %}{{ foodbank.name }}{% endblock %}

{# gfadmin/templates/admin/foodbank.html:93-145 -- every URL row there is TWO
   anchors, not one: a newwindow.svg icon that opens in a new tab, then a
   plain same-tab anchor carrying the visible text. Clicking the URL text in
   Django navigates in place; only the icon opens a new tab. `.newwindow img`
   is already styled in static/css/admin.css:136-140 (byte-identical to
   Django's copy). Macro rather than eight copies -- admin/query.njk already
   defines a top-level macro in a template that {% extends %}. #}
{% macro extlink(href, text) %}<a href="{{ href }}" target="_blank" rel="noopener" class="newwindow"><img src="/static/img/newwindow.svg" alt="New window"></a> <a href="{{ href }}">{{ text }}</a>{% endmacro %}

{% block body %}
<h1 class="title">{{ foodbank.name }}</h1>

{% if foodbank.is_closed %}<span class="tag is-danger">Closed</span>{% endif %}

<div class="tabs is-boxed">
  <ul role="tablist" aria-label="Foodbank">
    <li class="is-active" role="presentation"><a data-tab="generallocations" role="tab" aria-selected="true" aria-controls="generallocations-panel" id="generallocations-tab"><span class="icon"><i class="mdi mdi-bank"></i></span><span>General &amp; Locations <span class="tag is-info is-normal is-light">{{ counts.locations }}</span></span></a></li>
    <li role="presentation"><a data-tab="needsorders" role="tab" aria-selected="false" aria-controls="needsorders-panel" id="needsorders-tab"><span class="icon"><i class="mdi mdi-shopping"></i></span><span>Needs <span class="tag is-info is-normal is-light">{{ counts.needs }}</span> &amp; Orders <span class="tag is-info is-normal is-light">{{ counts.orders }}</span></span></a></li>
    <li role="presentation"><a data-tab="donationpoints" role="tab" aria-selected="false" aria-controls="donationpoints-panel" id="donationpoints-tab"><span class="icon"><i class="mdi mdi-store"></i></span><span>Donation Points <span class="tag is-info is-normal is-light">{{ counts.donation_points }}</span></span></a></li>
    {% if counts.articles %}<li role="presentation"><a data-tab="articles" role="tab" aria-selected="false" aria-controls="articles-panel" id="articles-tab"><span class="icon"><i class="mdi mdi-newspaper-variant-multiple-outline"></i></span><span>Articles <span class="tag is-info is-normal is-light">{{ counts.articles }}</span></span></a></li>{% endif %}
    <li role="presentation"><a data-tab="subscribers" role="tab" aria-selected="false" aria-controls="subscribers-panel" id="subscribers-tab"><span class="icon"><i class="mdi mdi-bell"></i></span><span>Subscribers <span class="tag is-info is-normal is-light">{{ counts.subscribers }}</span></span></a></li>
    {# foodbank.html:45-58 and views.py:617-622's lazy_tabs order -- the
       unconditional Crawls tab comes BEFORE the conditional Photos tab, which
       is always last. The photos count tag carries id="photos-count" because
       foodbank_tabs/photos.njk:57 fires decrementPhotoCount() at it (defined
       in the script block at the foot of this file, per foodbank.html:55 and
       :444-451). #}
    <li role="presentation"><a data-tab="crawls" role="tab" aria-selected="false" aria-controls="crawls-panel" id="crawls-tab"><span class="icon"><i class="mdi mdi-robot"></i></span><span>Crawls <span class="tag is-info is-normal is-light">{{ counts.crawls }}</span></span></a></li>
    {% if counts.photos %}<li role="presentation"><a data-tab="photos" role="tab" aria-selected="false" aria-controls="photos-panel" id="photos-tab"><span class="icon"><i class="mdi mdi-image"></i></span><span>Photos <span class="tag is-info is-normal is-light" id="photos-count">{{ counts.photos }}</span></span></a></li>{% endif %}
  </ul>
</div>

<div class="columns sections">
  {# THREE sibling columns share the `generallocations` class, exactly as
     gfadmin/templates/admin/foodbank.html:65 / :303 / :392 do -- tabber.js
     shows and hides by CLASS, so all three toggle together as one tab while
     laying out side by side. Only the first carries the panel id/ARIA. The
     port previously stacked all of this into ONE column, which is why the
     page rendered as a single narrow strip. #}
  <div class="column tabcontent generallocations" id="generallocations-panel" role="tabpanel" aria-labelledby="generallocations-tab">

    {# foodbank.html:71-79. Check is the AI icon pulled right, Edit is a real
       button -- both were bare "Edit · Check" text links here before. #}
    <a href="/admin/foodbank/{{ foodbank.slug }}/check/" class="is-pulled-right" title="Check"><img src="/static/img/ai.png" style="width:32px;" alt="Check"></a>

    <a href="/admin/foodbank/{{ foodbank.slug }}/edit/" class="button is-link is-light">Edit Food Bank</a>

    <form action="/admin/foodbank/{{ foodbank.slug }}/touch/" method="post" style="margin-top:10px">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <button type="submit" class="button is-link is-light" hx-post="/admin/foodbank/{{ foodbank.slug }}/touch/" hx-vals='{"csrf_token": "{{ csrf_token }}"}' hx-swap="outerHTML">Touch</button>
    </form>

    {# foodbank.html:82-84 -- shortcut shown only while the food bank has no
       orders at all; ?foodbank=<slug> preselects it (orderForm.ts:117-119).
       Without this the /admin/order/new/ route has no link into it anywhere
       in the admin. #}
    {% if not counts.orders %}
    <a href="/admin/order/new/?foodbank={{ foodbank.slug }}" class="button is-link is-light" style="margin-top:10px">New Order</a>
    {% endif %}

    {% if foodbank.notes %}<div class="box" style="margin-top:20px;">{{ foodbank.notes | linebreaksbr | safe }}</div>{% endif %}

    <h3 class="title is-5">URLs</h3>
    <a href="/admin/foodbank/{{ foodbank.slug }}/edit/urls/" class="button is-link is-small is-pulled-right is-light">Edit</a>
    <dl>
      <dt>Website</dt>
      <dd>{{ extlink(foodbank.url, foodbank.url | friendly_url) }}</dd>
      <dt>Shopping List URL</dt>
      <dd>{{ extlink(foodbank.shopping_list_url, foodbank.shopping_list_url | friendly_url) }}</dd>
      {% if foodbank.rss_url %}<dt>RSS</dt><dd>{{ extlink(foodbank.rss_url, foodbank.rss_url | friendly_url) }}</dd>{% endif %}
      {% if foodbank.news_url %}<dt>News URL</dt><dd>{{ extlink(foodbank.news_url, foodbank.news_url | friendly_url) }}</dd>{% endif %}
      {% if foodbank.locations_url %}<dt>Locations URL</dt><dd>{{ extlink(foodbank.locations_url, foodbank.locations_url | friendly_url) }}</dd>{% endif %}
      {% if foodbank.donation_points_url %}<dt>Donation Points URL</dt><dd>{{ extlink(foodbank.donation_points_url, foodbank.donation_points_url | friendly_url) }}</dd>{% endif %}
      {% if foodbank.contacts_url %}<dt>Contacts URL</dt><dd>{{ extlink(foodbank.contacts_url, foodbank.contacts_url | friendly_url) }}</dd>{% endif %}
    </dl>

    <h3 class="title is-5">Info</h3>
    <dl>
      <dt>GF Info</dt>
      <dd>{{ extlink("/needs/at/" + foodbank.slug + "/", foodbank.slug) }}</dd>
      {% if foodbank.facebook_page %}<dt>Facebook</dt><dd><a href="https://www.facebook.com/{{ foodbank.facebook_page }}" target="_blank" rel="noopener">{{ foodbank.facebook_page }}</a></dd>{% endif %}
      {% if foodbank.bankuet_slug %}<dt>Bankuet</dt><dd><a href="https://www.bankuet.co.uk/{{ foodbank.bankuet_slug }}/" target="_blank" rel="noopener">{{ foodbank.bankuet_slug }}</a></dd>{% endif %}
      {% if charity_register_url %}
      <dt>Charity register</dt>
      <dd>
        <a href="{{ charity_register_url }}" target="_blank" rel="noopener">{{ foodbank.charity_number }}</a>
        <form action="/admin/foodbank/{{ foodbank.slug }}/charity-crawl/" method="post" style="display:inline-block;margin-left:10px;">
          <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
          <button type="submit" class="button is-info is-small is-light">Force Charity Crawl</button>
        </form>
      </dd>
      {% if foodbank.charity_just_foodbank %}<dt>Charity just food bank</dt><dd>&#9989; Yes</dd>{% endif %}
      {% endif %}
      <dt>Network</dt><dd>{{ foodbank.network or "&nbsp;" | safe }}</dd>
      {% if foodbank.network_id %}<dt>Network ID</dt><dd>{{ foodbank.network_id }}</dd>{% endif %}
      <dt>FSA ID</dt>
      <dd>
        <a href="/admin/foodbank/{{ foodbank.slug }}/edit/fsa-id/" class="button is-link is-small is-pulled-right is-light">Edit</a>
        {% if foodbank.fsa_id %}<a href="{{ fsa_url }}" target="_blank" rel="noopener">{{ foodbank.fsa_id }}</a>
        {% else %}None (<a href="https://ratings.food.gov.uk/business-search?address-search={{ foodbank.postcode | urlencode }}" target="_blank" rel="noopener">Search</a>){% endif %}
      </dd>
      {% if foodbank.is_school %}<dt>Is school</dt><dd>&#9989; Yes</dd>{% endif %}
    </dl>

    <h3 class="title is-5">Contacts</h3>
    <a href="/admin/foodbank/{{ foodbank.slug }}/edit/email/" class="button is-link is-small is-pulled-right is-light">Edit Email</a>
    <a href="/admin/foodbank/{{ foodbank.slug }}/edit/phone/" class="button is-link is-small is-pulled-right is-light" style="margin-right:5px;">Edit Phone</a>
    <dl>
      <dt>Email</dt><dd><a href="mailto:{{ foodbank.contact_email }}">{{ foodbank.contact_email }}</a></dd>
      {% if foodbank.notification_email %}<dt>Delivery Email</dt><dd><a href="mailto:{{ foodbank.notification_email }}">{{ foodbank.notification_email }}</a></dd>{% endif %}
      {% if foodbank.phone_number %}<dt>Phone</dt><dd><a href="tel:{{ foodbank.phone_number }}">{{ foodbank.phone_number | friendly_phone }}</a></dd>{% endif %}
      {% if foodbank.secondary_phone_number %}<dt>Secondary phone</dt><dd><a href="tel:{{ foodbank.secondary_phone_number }}">{{ foodbank.secondary_phone_number | friendly_phone }}</a></dd>{% endif %}
      {% if foodbank.delivery_phone_number %}<dt>Delivery phone</dt><dd><a href="tel:{{ foodbank.delivery_phone_number }}">{{ foodbank.delivery_phone_number | friendly_phone }}</a></dd>{% endif %}
    </dl>

    <h3 class="title is-5">Politics</h3>
    <dl>
      <dt>Parl. Con.</dt><dd>{{ foodbank.parliamentary_constituency_name or "&nbsp;" | safe }}</dd>
      {% if foodbank.county %}<dt>County</dt><dd>{{ foodbank.county }}</dd>{% endif %}
      {% if foodbank.district %}<dt>District</dt><dd>{{ foodbank.district }}</dd>{% endif %}
      {% if foodbank.ward %}<dt>Ward</dt><dd>{{ foodbank.ward }}</dd>{% endif %}
      <dt>Country</dt><dd>{{ foodbank.country }}</dd>
    </dl>

    <h3 class="title is-5">Stats</h3>
    <dl>
      <dt>Subscribers</dt><dd>{{ number_subscribers }}</dd>
      <dt>Days Between Needs</dt><dd>{{ foodbank.days_between_needs }}</dd>
      <dt>Orders</dt><dd>{{ no_orders }}</dd>
      {# foodbank.html:241-248 -- these four, and only these four, carry
         |intcomma ({% load humanize %} at :2 exists solely for them). No
         floatformat: Django applies intcomma alone here, unlike
         admin/order_group.njk where Django itself chains floatformat first. #}
      <dt>Total weight</dt><dd>{{ total_weight_kg|intcomma }} kg</dd>
      <dt>Total weight (pkging)</dt><dd>{{ total_weight_kg_pkg|intcomma }} kg</dd>
      <dt>Total items</dt><dd>{{ total_items|intcomma }}</dd>
      <dt>Total cost</dt><dd>&pound;{{ total_cost|intcomma }}</dd>
      <dt>Locations</dt><dd>{{ counts.locations }}</dd>
      <dt>Donation Points</dt><dd>{{ counts.donation_points }}</dd>
    </dl>

    <h3 class="title is-5">Dates</h3>
    <dl>
      <dt>Created</dt><dd>{{ foodbank.created|date("N j, Y, P") }}</dd>
      <dt>Modified</dt><dd>{{ foodbank.modified|date("N j, Y, P") }}</dd>
      <dt>Edited</dt><dd>{{ (foodbank.edited|date("N j, Y, P")) if foodbank.edited else ("&nbsp;" | safe) }}</dd>
      <dt>Last Need</dt><dd>{{ (foodbank.last_need|date("N j, Y, P")) if foodbank.last_need else ("&nbsp;" | safe) }}</dd>
      <dt>Last Need Check</dt>
      <dd>
        {{ foodbank.last_need_check|date("N j, Y, P") if foodbank.last_need_check else "" }}<br>
        <form action="/admin/foodbank/{{ foodbank.slug }}/needcheck/" method="post">
          <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
          <button type="submit" class="button is-info is-small is-light">Force Check</button>
        </form>
      </dd>
      <dt>Last RFI</dt><dd>{{ (foodbank.last_rfi|date("N j, Y, P")) if foodbank.last_rfi else ("&nbsp;" | safe) }}</dd>
      <dt>Last Discrepancy Check</dt><dd>{{ (foodbank.last_discrepancy_check|date("N j, Y, P")) if foodbank.last_discrepancy_check else ("&nbsp;" | safe) }}</dd>
      {% if foodbank.rss_url or foodbank.news_url %}
      <dt>Last Crawl</dt>
      <dd>
        {{ (foodbank.last_crawl|date("N j, Y, P")) if foodbank.last_crawl else ("&nbsp;" | safe) }}
        <form action="/admin/foodbank/{{ foodbank.slug }}/crawl/" method="post">
          <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
          <button type="submit" class="button is-info is-small is-light">Force Article Crawl</button>
        </form>
      </dd>
      {% endif %}
    </dl>


    {# foodbank.html:295-299's "Really Dangerous Zone". Django's other two
       danger zones there -- Resave Everything and Send RFI -- are deliberately
       not ported (the maintainer scoped both out), so this is the only one. #}
    <h3 class="title is-5"><span class="mdi mdi-alert"></span> Really Dangerous Zone</h3>
    <form action="/admin/foodbank/{{ foodbank.slug }}/delete/" method="post" data-name="{{ foodbank.name }}" onsubmit="return confirm('DELETE ' + this.dataset.name + '?');">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <button type="submit" class="button is-danger is-light">Delete {{ full_name }}</button>
    </form>

  </div>

  {# foodbank.html:303 -- COLUMN 2: locations, and the buttons that add them. #}
  <div class="column tabcontent generallocations">

    <a href="/admin/foodbank/{{ foodbank.slug }}/location/new/" class="button is-link is-light">New Location</a>
    <a href="/admin/foodbank/{{ foodbank.slug }}/location/new/area/" class="button is-link is-light">New Location Area</a>

    <h3 class="title is-5">Locations ({{ locations.length }})</h3>
    {# foodbank.html:307-388 -- a THREE-cell table: label, detail, controls.
       Row 1 is the food bank's OWN main address (the only link into
       /admin/foodbank/<slug>/edit/address/ from this page), row 2 the
       delivery address when there is one, then one row per location. The
       `locationtable` class is what static/css/admin.css:103-107 styles.
       Every field below is already on FoodbankRow / FoodbankLocationRow --
       getLocationsByFoodbankId is a SELECT *, so no query change is needed. #}
    <table class="table is-fullwidth locationtable">
      <tr>
        <td>Main</td>
        <td>
          {{ foodbank.address | linebreaksbr | safe }}<br>{{ foodbank.postcode }}
          <dl class="is-size-7">
            <dt>Lat Lng</dt>
            <dd><a href="https://www.google.co.uk/maps/?q={{ foodbank.lat_lng }}">{{ foodbank.lat_lng }}</a></dd>
            <dt>Place ID</dt>
            <dd>{% if foodbank.place_id %}{{ foodbank.place_id | truncatechars(25) }}{% else %}None{% endif %}</dd>
            {% if foodbank.address_is_administrative %}<dt>Just administrative location</dt><dd>&#9989; Yes</dd>{% endif %}
            {% if foodbank.place_has_photo %}<dt>Place ID has photo</dt><dd>&#9989; Yes</dd>{% endif %}
          </dl>
        </td>
        <td><a href="/admin/foodbank/{{ foodbank.slug }}/edit/address/" class="button is-link is-small is-pulled-right is-light">Edit</a></td>
      </tr>
      {% if foodbank.delivery_address %}
      <tr>
        <td>Delivery</td>
        <td>
          {{ foodbank.delivery_address | linebreaksbr | safe }}
          <dl class="is-size-7">
            <dt>Lat Lng</dt>
            <dd><a href="https://www.google.co.uk/maps/?q={{ foodbank.delivery_lat_lng }}">{{ foodbank.delivery_lat_lng }}</a></dd>
          </dl>
        </td>
        <td><a href="/admin/foodbank/{{ foodbank.slug }}/edit/#id_delivery_address" class="button is-link is-small is-pulled-right is-light">Edit</a></td>
      </tr>
      {% endif %}
      {% for loc in locations %}
      <tr>
        <td>{{ loc.name }}</td>
        <td>
          {% if loc.address %}{{ loc.address | linebreaksbr | safe }}{% endif %}{% if loc.address and loc.postcode %}<br>{% endif %}{% if loc.postcode %}{{ loc.postcode }}{% endif %}
          <dl class="is-size-7">
            {% if loc.phone_number %}<dt>Phone</dt><dd>{{ loc.phone_number }}</dd>{% endif %}
            {% if loc.email %}<dt>Email</dt><dd>{{ loc.email }}</dd>{% endif %}
            <dt>Lat Lng</dt>
            <dd><a href="https://www.google.co.uk/maps/?q={{ loc.lat_lng }}">{{ loc.lat_lng }}</a></dd>
            <dt>Place ID</dt>
            <dd>{% if loc.place_id %}{{ loc.place_id | truncatechars(25) }}{% else %}None{% endif %}</dd>
            {% if loc.place_has_photo %}<dt>Place ID has photo</dt><dd>&#9989; Yes</dd>{% endif %}
            {% if loc.is_donation_point %}<dt>Donation Point</dt><dd>&#9989; Yes</dd>{% endif %}
            {% if loc.boundary_geojson %}<dt>Is Service Area</dt><dd>&#9989; Yes</dd>{% endif %}
          </dl>
        </td>
        <td>
          <a href="/admin/foodbank/{{ foodbank.slug }}/location/{{ loc.slug }}/edit/" class="button is-link is-small is-pulled-right is-light">Edit</a>
          {# data-name + this.dataset.name, never the value interpolated into
             the JS string -- a location name with an apostrophe would break
             the confirm() otherwise. Same pattern as the food bank delete
             form in the Really Dangerous Zone above. #}
          <form action="/admin/foodbank/{{ foodbank.slug }}/location/{{ loc.slug }}/delete/" method="post" data-name="{{ loc.name }}" onsubmit="return confirm('Delete ' + this.dataset.name + '?');">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
            <button type="submit" class="button is-small is-danger is-pulled-right is-light">Delete</button>
          </form>
        </td>
      </tr>
      {% endfor %}
    </table>
  </div>

  {# foodbank.html:392 -- COLUMN 3: the latest need. #}
  <div class="column tabcontent generallocations">

    {# gfadmin/templates/admin/foodbank.html:394 and :461 -- Django puts a
       "New Need" button on this page twice, both carrying ?foodbank=<slug>
       to pre-select the food bank (views.py:1926-1937's initial=). This is
       the only entry point the need-creation form has, in either codebase. #}
    <a href="/admin/need/new/?foodbank={{ foodbank.slug }}" class="button is-link is-light is-pulled-right is-small">New Need</a>

    <h3 class="title is-5">Latest Need</h3>
    {% if foodbank.latestNeed %}
      <p>
        {{ foodbank.latestNeed.input_method_emoji | safe }}
        <strong><a href="/admin/need/{{ foodbank.latestNeed.need_id }}/">{{ foodbank.latestNeed.need_id_short }}</a></strong>
        {{ foodbank.latestNeed.created_timesince }}
      </p>
      {# foodbank.html:404-417 -- a two-column .columns NESTED inside this
         third generallocations column, giving a side-by-side Need / Excess
         pair. Not a single box: excess_change_text is a real field
         (packages/db/src/needs.ts:16) and Django prints it here. The <h4>s
         are bare in Django too -- static/css/admin.css (byte-identical to
         Django's) styles h1/h2/h3 only. No {% if %} around Excess: Django
         renders an empty <p> when excess_change_text is null. #}
      <div class="columns">
        <div class="column">
          <h4>Need</h4>
          <p>{{ foodbank.latestNeed.change_text | linebreaksbr | safe }}</p>
        </div>
        <div class="column">
          <h4>Excess</h4>
          <p>{{ foodbank.latestNeed.excess_change_text | linebreaksbr | safe }}</p>
        </div>
      </div>
    {% else %}
      {# foodbank.html:420 -- wording and margin match Django, and match this
         port's own foodbank_tabs/needsorders.njk empty state. #}
      <p style="margin-top:20px;">No needs yet</p>
    {% endif %}
  </div>

  <div class="column tabcontent needsorders is-hidden" id="needsorders-panel" role="tabpanel" aria-labelledby="needsorders-tab"
       hx-get="/admin/foodbank/{{ foodbank.slug }}/tab/needsorders/" hx-trigger="showtab once" hx-swap="innerHTML swap:0.06s">
    <div class="loading"><span class="loader"></span></div>
  </div>

  <div class="column tabcontent donationpoints is-hidden" id="donationpoints-panel" role="tabpanel" aria-labelledby="donationpoints-tab"
       hx-get="/admin/foodbank/{{ foodbank.slug }}/tab/donationpoints/" hx-trigger="showtab once" hx-swap="innerHTML swap:0.06s">
    <div class="loading"><span class="loader"></span></div>
  </div>

  {% if counts.articles %}
  <div class="column tabcontent articles is-hidden" id="articles-panel" role="tabpanel" aria-labelledby="articles-tab"
       hx-get="/admin/foodbank/{{ foodbank.slug }}/tab/articles/" hx-trigger="showtab once" hx-swap="innerHTML swap:0.06s">
    <div class="loading"><span class="loader"></span></div>
  </div>
  {% endif %}

  <div class="column tabcontent subscribers is-hidden" id="subscribers-panel" role="tabpanel" aria-labelledby="subscribers-tab"
       hx-get="/admin/foodbank/{{ foodbank.slug }}/tab/subscribers/" hx-trigger="showtab once" hx-swap="innerHTML swap:0.06s">
    <div class="loading"><span class="loader"></span></div>
  </div>

  {# Panel order follows views.py:617-622's lazy_tabs: crawls, then photos
     last -- kept in step with the tab strip above. #}
  <div class="column tabcontent crawls is-hidden" id="crawls-panel" role="tabpanel" aria-labelledby="crawls-tab"
       hx-get="/admin/foodbank/{{ foodbank.slug }}/tab/crawls/" hx-trigger="showtab once" hx-swap="innerHTML swap:0.06s">
    <div class="loading"><span class="loader"></span></div>
  </div>

  {% if counts.photos %}
  <div class="column tabcontent photos is-hidden" id="photos-panel" role="tabpanel" aria-labelledby="photos-tab"
       hx-get="/admin/foodbank/{{ foodbank.slug }}/tab/photos/" hx-trigger="showtab once" hx-swap="innerHTML swap:0.06s">
    <div class="loading"><span class="loader"></span></div>
  </div>
  {% endif %}
</div>
{% endblock %}

{% block script %}
<script src="/static/js/tabber.js?v={{ version }}" defer></script>
<script>
  // gfadmin/templates/admin/foodbank.html:444-451 -- foodbank_tabs/photos.njk:57
  // calls this from hx-on::after:request so the Photos tab badge tracks deletes
  // without a page reload. Must stay a plain global function declaration: htmx
  // evaluates the hx-on body through the Function constructor, which resolves
  // names against globalThis.
  function decrementPhotoCount() {
    const countEl = document.getElementById('photos-count');
    if (countEl) {
      const currentCount = parseInt(countEl.textContent, 10);
      countEl.textContent = currentCount - 1;
    }
  }
</script>
{% endblock %}
