{% extends "admin/page.njk" %}

{# need_translations.html:3 is `{{ need }}`, i.e. FoodbankChange.__str__
   (givefood/models/needs.py:84-85). A constant "Translations" titled every
   need's page identically, so several open in tabs were indistinguishable.
   Verbatim copy of need.njk:9, including its "Unknown" fallback for a null
   foodbank_name (__str__ would interpolate the literal "None"). #}
{% block title %}{{ need.foodbank_name or "Unknown" }} - {{ need.created|date("M d Y H:i:s") }} ({{ need.need_id_short }}){% endblock %}

{% block body %}
<div class="columns">
  <div class="column">
    <dl>
      <dt>ID</dt>
      <dd><a href="/admin/need/{{ need.need_id }}/">{{ need.need_id_short }}</a></dd>
      <dt>Food Bank</dt>
      <dd>{% if foodbank_slug %}<a href="/admin/foodbank/{{ foodbank_slug }}/">{{ need.foodbank_name }}</a>{% else %}{{ need.foodbank_name or "Unknown" }}{% endif %}</dd>
      <dt>Input Method</dt>
      <dd>{{ need.input_method_emoji | safe }} {{ need.input_method_human }}</dd>
      {# need_translations.html:31,33 -- the bare `{{ need.created|date("N j, Y, P") }}` in
         `title` localises through USE_L10N to DATETIME_FORMAT, so the hover
         reads "Sept. 2, 2026, 7:39 p.m."; passing the raw D1 column showed a
         machine timestamp instead. Same treatment as need.njk:23,25. The
         `datetime` attributes stay raw ISO on purpose -- that is the port's
         convention on need.njk, order.njk and discrepancy.njk alike. #}
      <dt>Created</dt>
      <dd><time datetime="{{ need.created }}" title="{{ need.created|date("N j, Y, P") }}">{{ need.created_timesince }}</time></dd>
      <dt>Modified</dt>
      <dd><time datetime="{{ need.modified }}" title="{{ need.modified|date("N j, Y, P") }}">{{ need.modified_timesince }}</time></dd>
    </dl>
  </div>

  <div class="column is-three-quarters">
    <h2>English</h2>
    <dl>
      <dt>Needs</dt>
      <dd>{{ need.change_text | linebreaksbr | safe }}</dd>
      {% if need.excess_change_text %}
        <dt>Excess</dt>
        <dd>{{ need.excess_change_text | linebreaksbr | safe }}</dd>
      {% endif %}
    </dl>

    <h2>Translations</h2>
    {% for translation in translations %}
      <h3>{{ translation.language }}</h3>
      <dl>
        <dt>Needs</dt>
        <dd>{{ translation.change_text | linebreaksbr | safe }}</dd>
        {% if translation.excess_change_text %}
          <dt>Excess</dt>
          <dd>{{ translation.excess_change_text | linebreaksbr | safe }}</dd>
        {% endif %}
      </dl>
    {% else %}
      <p>No translations yet.</p>
    {% endfor %}
  </div>
</div>
{% endblock %}
