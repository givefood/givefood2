{% extends "admin/page.njk" %}
{% from "admin/includes/formfields.njk" import fieldset %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
<div class="columns">
  <div class="column is-half">
    <h1 class="title">{{ title }}</h1>
    <p class="subtitle">{{ foodbank.name }}{% if foodbank.slug %} -- <a href="/admin/foodbank/{{ foodbank.slug }}/">View</a>{% endif %}</p>

    <form method="post">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      {{ fieldset(fields, foodbank) }}
      <div class="field">
        <div class="control">
          <button type="submit" class="button is-link is-light">Save</button>
        </div>
      </div>
    </form>

    {% if foodbank.slug %}
      <div class="buttons">
        <a href="/admin/foodbank/{{ foodbank.slug }}/location/new/" class="button is-light is-small">New Location</a>
        <a href="/admin/foodbank/{{ foodbank.slug }}/donationpoint/new/" class="button is-light is-small">New Donation Point</a>
      </div>

      {% if show_delete %}
      <form method="post" action="/admin/foodbank/{{ foodbank.slug }}/delete/" onsubmit="return confirm('Are you sure you want to DELETE this food bank and everything under it? This cannot be undone.')">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
        <button type="submit" class="button is-danger is-light">Delete Foodbank</button>
      </form>
      {% endif %}
    {% endif %}
  </div>

  {% if show_proxy %}
  <div class="column is-half">
    <h3>Preview</h3>
    <iframe class="preview-frame" src="/admin/proxy/?foodbank={{ foodbank.slug }}&amp;field=url" style="width:100%;height:1000px;border:none;" loading="lazy"></iframe>
  </div>
  {% endif %}
</div>
{% endblock %}
