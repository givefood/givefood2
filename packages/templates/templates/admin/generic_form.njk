{% extends "admin/page.njk" %}
{% from "admin/includes/formfields.njk" import fieldset %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
<div class="columns">
  <div class="column is-half">
    <h1 class="title">{{ title }}</h1>
    {% if back_url %}<p><a href="{{ back_url }}">&larr; Back</a></p>{% endif %}

    {# class="form-<slugified title>" matches Django admin/form.html:14's
       `class="form-{{ page_title|slugify }}"`. static/js/admin.js selects on
       exactly these class names (.form-new-food-bank,
       .form-new-donation-point, .form-edit-donation-point and
       form[class*='food-bank-location'], admin.js:105-109) to decide which
       address-lookup button to inject, so without it none appear. #}
    <form method="post" class="form-{{ title | slugify }}">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      {{ fieldset(fields, data) }}
      <div class="field">
        <div class="control">
          <button type="submit" class="button is-link is-light">Save</button>
        </div>
      </div>
    </form>

    {% if delete_url %}
    <form method="post" action="{{ delete_url }}" onsubmit="return confirm('Are you sure you want to DELETE?')">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <button type="submit" class="button is-danger is-light">Delete</button>
    </form>
    {% endif %}
  </div>

  {# admin/form.html:20-36 -- Django's generic form renders the source page
     beside the fields, so an admin can read the food bank's own site while
     retyping from it. The port had NO preview on any edit form at all.
     Driven by an optional `preview_field` the route sets (one of
     routes/admin/proxy.ts's five PROXYABLE_FIELDS), rather than Django's
     `?url=` -- that parameter is the unrestricted SSRF WP 6.3 fixed, so the
     caller names a field and the proxy resolves the URL from D1 itself. #}
  {% if preview_field and preview_foodbank_slug %}
  <div class="column">
    <iframe class="preview-frame" src="/admin/proxy/?foodbank={{ preview_foodbank_slug }}&amp;field={{ preview_field }}" style="width:100%;height:1000px;border:none;" loading="lazy"></iframe>
  </div>
  {% endif %}

</div>
{% endblock %}
