{% extends "admin/page.njk" %}

{% block title %}{{ order.order_id }}{% endblock %}

{% block body %}
<div class="columns">
  <div class="column is-two-fifths">

    {# routes/admin/orderForm.ts redirects here with ?job=<id> after a save --
       the order's lines and totals are parsed by a queue job, so a
       just-saved order legitimately reads 0 items / £0.00 for a few seconds.
       Without this the page looks like the save silently lost everything. #}
    {% if job_status %}
      {% if job_status == "failed" %}
      <div class="notification is-danger is-light">
        The items text could not be parsed into order lines{% if job_error %}: {{ job_error }}{% endif %}
      </div>
      {% elif job_status == "done" %}
      <div class="notification is-success is-light">Order lines parsed.</div>
      {% else %}
      <div class="notification is-info is-light" hx-get="/admin/job/{{ job_id }}/" hx-trigger="every 2s" hx-swap="outerHTML">
        Parsing the items text into order lines&hellip;
      </div>
      {% endif %}
    {% endif %}

    {# order.html:12 -- Edit sits top-right of the detail column. #}
    <a href="/admin/order/{{ order.order_id }}/edit/" class="button is-link is-pulled-right is-light">Edit</a>

    <dl>
      <dt>ID</dt>
      <dd>{{ order.order_id }}</dd>
      <dt>Foodbank</dt>
      <dd>{% if order.foodbank_slug %}<a href="/admin/foodbank/{{ order.foodbank_slug }}/">{{ order.foodbank_name }}</a>{% else %}<em>Unassigned</em>{% endif %}</dd>
      <dt>Delivery hour</dt>
      <dd>{{ order.delivery_date|date("D") }}, {{ order.delivery_date|date("N j, Y") }}, {{ order.delivery_hour }}:00</dd>
      <dt>Items</dt>
      <dd>{{ order.no_items }}</dd>
      <dt>Lines</dt>
      <dd>{{ order.no_lines }}</dd>
      <dt>Weight</dt>
      <dd>{{ weight_kg }} kg</dd>
      <dt>Total weight (pkging)</dt>
      <dd>{{ weight_kg_pkg }} kg</dd>
      <dt>Calories</dt>
      <dd>{{ order.calories|intcomma }}</dd>
      <dt>Cost</dt>
      <dd>&pound;{{ cost }}</dd>
      {% if actual_cost %}
      <dt>Delivered cost</dt>
      <dd>&pound;{{ actual_cost }}</dd>
      {% endif %}
      {# order.html:45-48 -- {{ order.order_group }} is OrderGroup.__str__,
         i.e. its name (models/orders.py:329-330). #}
      {% if order.order_group_slug %}
      <dt>Order group</dt>
      <dd><a href="/admin/order-group/{{ order.order_group_slug }}/">{{ order.order_group_name }}</a></dd>
      {% endif %}
      {% if order.source_url %}
      <dt>Source URL</dt>
      <dd><a href="{{ order.source_url }}" target="_blank" rel="noopener">{{ order.source_url }}</a></dd>
      {% endif %}
      {% if order.delivery_provider %}
      <dt>Delivery</dt>
      <dd>{% if delivery_provider_url %}<a href="{{ delivery_provider_url }}" target="_blank" rel="noopener">{{ order.delivery_provider }}</a>{% else %}{{ order.delivery_provider }}{% endif %}</dd>
      {% endif %}
      {% if order.delivery_provider_id %}
      <dt>Del. Prov. ID</dt>
      <dd>{{ order.delivery_provider_id }}</dd>
      {% endif %}
      <dt>Created</dt>
      <dd>{{ order.created|date("N j, Y, P") }}</dd>
      <dt>Modified</dt>
      <dd>{{ order.modified|date("N j, Y, P") }}</dd>
    </dl>

    {% if order.need_id %}
    {# order.html:75 -- the link text is need_id_short, the first 7 chars
       (models/needs.py:81-82); the href keeps the full id. #}
    <h2>Need <a href="/admin/need/{{ order.need_id_str }}/">{{ order.need_id_short }}</a></h2>
    <p>{{ order.need_change_text | linebreaksbr | safe }}</p>
    <dl>
      <dt>Found</dt>
      <dd>{{ order.need_created|date("N j, Y, P") }}</dd>
      {% if order.need_uri %}
      <dt>URL</dt>
      <dd><a href="{{ order.need_uri }}" target="_blank" rel="noopener">{{ order.need_uri }}</a></dd>
      {% endif %}
    </dl>
    {% endif %}

    {% if order.foodbank_id %}
    <h2>Notification</h2>
    <p>
      {% if order.notification_email_sent %}
      <span style="color:green">&#10003;</span> Sent <time datetime="{{ order.notification_email_sent }}" title="{{ order.notification_email_sent|date("N j, Y, P") }}">{{ notification_email_sent_timesince }}</time>
      {% else %}
      <span style="color:red">x</span> Not Sent
      {% endif %}
    </p>
    {# order.html:96-99. Django has no @require_POST on order_send_notification;
       POST+CSRF here, since it sends real mail to a food bank. #}
    <form action="/admin/order/{{ order.order_id }}/sendnotification/" method="post" style="display:inline"
          onsubmit="return confirm('Send the delivery notification email to this food bank?');">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <button type="submit" class="button is-warning is-light">Send Notification</button>
    </form>
    <a href="/admin/order/{{ order.order_id }}/email/" class="button is-light" target="_blank" rel="noopener">Preview email</a>
    {% endif %}

    {# order.html:102-106's Danger Zone. Django labels the button "Cancel"
       while the URL and view are order_delete; kept as Delete here so the
       label matches what it does. #}
    <h2><span class="mdi mdi-alert"></span> Danger Zone</h2>
    <form action="/admin/order/{{ order.order_id }}/delete/" method="post"
          onsubmit="return confirm('Delete this order and all its lines? This cannot be undone.');">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <button type="submit" class="button is-danger is-light">Delete</button>
    </form>
  </div>

  <div class="column">
    <table class="table is-fullwidth is-hoverable">
      <thead>
        <tr><th>Name</th><th>Quantity</th><th>Weight</th><th>Calories</th></tr>
      </thead>
      <tbody>
        {% for line in lines %}
        <tr>
          <td>{{ line.name }}</td>
          <td>{{ line.quantity }}</td>
          <td>{{ (line.weight or 0)|intcomma }}g</td>
          {# order.html:124-132 -- a 0-calorie line means no OrderItem row
             exists for that name, so Django offers a one-click Add. Django
             gets the pre-fill by POSTing a deliberately invalid form to
             item_new; routes/admin/items.ts:74-81 replaces that with
             GET ?name=, so this is a plain link. #}
          <td>{{ (line.calories or 0)|intcomma }}{% if not line.calories %} <a href="/admin/item/new/?name={{ line.name|urlencode }}" target="_blank" rel="noopener" class="button is-small is-light">Add</a>{% endif %}</td>
        </tr>
        {% else %}
        <tr><td colspan="4">None</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
{% endblock %}
