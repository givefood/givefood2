{# gfadmin/templates/admin/includes/needtable.html -- one row per need, shared by the dashboard's unpublished/published panels. Food bank name isn't a link yet -- there's no admin food bank page to link to until WP 6.5/6.6 build one. #}
<table class="table is-fullwidth">
  <tbody>
    {% for need in needs %}
    <tr>
      <td class="input-method">{{ need.input_method_emoji }}</td>
      <td>{{ need.foodbank_name or "Unknown" }}</td>
      <td><a href="/admin/need/{{ need.need_id }}/">{{ need.created }}</a></td>
      {% if not need.published %}
      <td>
        <form method="post" action="/admin/need/{{ need.need_id }}/delete/" onsubmit="return confirm('Delete this need?');">
          <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
          <button type="submit" class="button is-small is-danger is-light">Delete</button>
        </form>
      </td>
      {% else %}
      <td></td>
      {% endif %}
    </tr>
    {% else %}
    <tr><td colspan="4">None</td></tr>
    {% endfor %}
  </tbody>
</table>
