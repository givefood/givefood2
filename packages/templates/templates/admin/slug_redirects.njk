{# gfadmin/templates/admin/slug_redirects.html (37 lines), plus the two
   port-only additions described below. Its own template rather than the
   shared admin/list.njk, because list.njk has no slot for the note about
   propagation delay, which this is the one admin list that needs.

   Django's table: 4 columns (Old Slug / New Slug / Created / Edit link),
   no count, no empty state, no pagination. The count, the "None" row and
   the pagination nav are the port's standard list-page additions -- see
   admin/list.njk, whose markup this deliberately mirrors. #}
{% extends "admin/page.njk" %}

{% block title %}Slug Redirects{% endblock %}

{% block body %}
<div class="columns">
  <div class="column">
    <h1 class="title">Slug Redirects ({{ total }})</h1>

    <div class="buttons">
      <a href="/admin/slug-redirect/new/" class="button is-link is-light">New Slug Redirect</a>
    </div>

    {# PORT ONLY -- no Django equivalent. Django's own admin says nothing
       about propagation because its cache is invisible; this says it out
       loud so nobody wonders whether a save "worked". Django caches the
       same map for 3600s with nothing invalidating it on save
       (givefood/utils/cache.py:12-32), so there a new redirect can take an
       hour unless someone hits /admin/clearcache/. #}
    <div class="notification is-light">
      <p class="help">
        Redirects are served from this table. A save goes live within about
        five minutes rather than instantly -- middleware/slugRedirect.ts
        memoises the map for that long per warm isolate, so it is not
        querying D1 on every food bank page view.
      </p>
    </div>

    <table class="table is-fullwidth is-hoverable">
      <thead>
        <tr>
          <th>Old Slug</th>
          <th>New Slug</th>
          <th>Created</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {% for row in rows %}
        <tr>
          <td>{{ row.old_slug }}</td>
          <td>{{ row.new_slug }}</td>
          {# Django uses `|naturaltime` here; the port has no naturaltime,
             and every other ported list column uses this two-line cell --
             Django's own DATETIME_FORMAT on the first line, relative time
             beneath. Never a raw D1 timestamp. #}
          <td>{{ row.created|date("N j, Y, P") }}<br><span class="is-size-7">{{ row.created_ago }} ago</span></td>
          <td><a href="/admin/slug-redirect/{{ row.id }}/edit/" class="button is-small is-light">Edit</a></td>
        </tr>
        {% else %}
        <tr><td colspan="4">None</td></tr>
        {% endfor %}
      </tbody>
    </table>

    <nav class="pagination" role="navigation" aria-label="pagination">
      {% if page > 1 %}<a class="pagination-previous" href="?page={{ page - 1 }}">Previous</a>{% endif %}
      {% if has_next %}<a class="pagination-next" href="?page={{ page + 1 }}">Next page</a>{% endif %}
      <span class="pagination-list">Page {{ page }} of {{ total_pages }}</span>
    </nav>
  </div>
</div>
{% endblock %}
