{% extends "admin/page.njk" %}
{% from "admin/includes/formfields.njk" import fieldset %}

{% block title %}Discrepancy{% endblock %}

{% block body %}
<div class="columns">
  <div class="column">
    {# discrepancy.html:12's bare <h2>Discrepancy</h2>, promoted to <h1 class="title"> the way
       every other ported admin page does (see stats.njk's own note). #}
    <h1 class="title">Discrepancy</h1>
    <dl>
      <dt>Food Bank</dt>
      <dd>{% if foodbank %}<a href="/admin/foodbank/{{ foodbank.slug }}/">{{ discrepancy.foodbank_name }}</a>{% else %}{{ discrepancy.foodbank_name or "Unknown" }}{% endif %}</dd>
      {# discrepancy.html:16-17 -- the AI's finding is a labelled dt/dd inside this same dl,
         aligned with Food Bank and URL, using the mdi robot glyph rather than an emoji. #}
      <dt><span class="mdi mdi-robot"></span> thinks...</dt>
      <dd>{{ discrepancy.discrepancy_text }}</dd>
      <dt>Type</dt>
      <dd>{{ discrepancy.discrepancy_type }}</dd>
      <dt>Status</dt>
      <dd>{{ discrepancy.status }}</dd>
      <dt>Created</dt>
      <dd><time datetime="{{ discrepancy.created }}">{{ discrepancy.created|date("N j, Y, P") }}</time></dd>
      {% if discrepancy.url %}
        <dt>URL</dt>
        <dd><a href="{{ discrepancy.url }}" target="_blank" rel="noopener">{{ discrepancy.url }}</a></dd>
      {% endif %}
    </dl>

    {# discrepancy.html:23-26 renders the action form unconditionally, whatever the status --
       views.py:2206-2217 accepts the transition from any status, and so does
       adminDiscrepancyAction/setDiscrepancyStatus. Gating on status == "New" hid the only
       dismiss path from anyone who reloaded or hit Back after actioning a discrepancy. #}
    <form action="/admin/discrepancy/{{ discrepancy.id }}/action/" method="post" style="display:inline">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <input type="hidden" name="action" value="done">
      <input type="submit" class="button is-link is-light" value="Done">
    </form>
    <form action="/admin/discrepancy/{{ discrepancy.id }}/action/" method="post" style="display:inline">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <input type="hidden" name="action" value="invalid">
      {# discrepancy.html:25 -- is-danger, matching both dashboards' red ✗ for the same action. #}
      <input type="submit" class="button is-danger is-light" value="Invalid">
    </form>
  </div>

  {% if foodbank %}
  <div class="column">
    <form method="post" action="/admin/foodbank/{{ foodbank.slug }}/edit/?discrepancy={{ discrepancy.id }}">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      {{ fieldset(foodbank_fields, foodbank) }}
      <div class="field">
        <div class="control">
          {# discrepancy.html:34's onclick guard, kept. This POST is a full foodbank save
             plus the discrepancy resolution, and greying the button out is the only
             in-flight feedback the page gives. Same idiom as need_new.njk:73. #}
          <button type="submit" class="button is-link is-light" onclick="this.form.submit();this.disabled = true;">Submit</button>
        </div>
      </div>
    </form>
  </div>
  {% endif %}

  {% if show_proxy %}
  <div class="column">
    <h3>Preview</h3>
    <iframe class="preview-frame" src="{{ proxy_src }}" style="width:100%;height:1000px;border:none;" loading="lazy"></iframe>
  </div>
  {% endif %}
</div>
{% endblock %}
