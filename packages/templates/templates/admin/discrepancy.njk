{% extends "admin/page.njk" %}

{% block title %}Discrepancy{% endblock %}

{% block body %}
<div class="columns">
  <div class="column">
    <dl>
      <dt>Food Bank</dt>
      <dd>{{ discrepancy.foodbank_name or "Unknown" }}</dd>
      <dt>Type</dt>
      <dd>{{ discrepancy.discrepancy_type }}</dd>
      <dt>Status</dt>
      <dd>{{ discrepancy.status }}</dd>
      <dt>Created</dt>
      <dd><time datetime="{{ discrepancy.created }}">{{ discrepancy.created }}</time></dd>
      {% if discrepancy.url %}
        <dt>URL</dt>
        <dd><a href="{{ discrepancy.url }}">{{ discrepancy.url | truncatechars(35) }}</a></dd>
      {% endif %}
    </dl>

    <div class="box"><p>&#129302; {{ discrepancy.discrepancy_text }}</p></div>

    {% if discrepancy.status == "New" %}
      <form action="/admin/discrepancy/{{ discrepancy.id }}/action/" method="post" style="display:inline">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
        <input type="hidden" name="action" value="done">
        <input type="submit" class="button is-link is-light" value="Done">
      </form>
      <form action="/admin/discrepancy/{{ discrepancy.id }}/action/" method="post" style="display:inline">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
        <input type="hidden" name="action" value="invalid">
        <input type="submit" class="button is-warning is-light" value="Invalid">
      </form>
    {% endif %}
  </div>

  {% if show_proxy %}
  <div class="column is-half">
    <h3>Preview</h3>
    <iframe class="preview-frame" src="{{ proxy_src }}" style="width:100%;height:1000px;border:none;" loading="lazy"></iframe>
  </div>
  {% endif %}
</div>
{% endblock %}
