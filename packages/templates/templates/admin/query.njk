{% extends "admin/page.njk" %}

{% block title %}{{ title }}{% endblock %}

{% macro resultTable(columns, rows) %}
  {% if rows.length %}
  <div class="table-container">
    <table class="table is-fullwidth is-striped is-bordered">
      <thead>
        <tr>{% for col in columns %}<th>{{ col }}</th>{% endfor %}</tr>
      </thead>
      <tbody>
        {% for row in rows %}
        <tr>{% for col in columns %}<td>{{ row[col] }}</td>{% endfor %}</tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% else %}
  <p>No rows.</p>
  {% endif %}
{% endmacro %}

{% block body %}
<div class="columns">
  <div class="column">
    <h1 class="title">{{ title }}</h1>
    <p>Read-only. Only <code>SELECT</code> and <code>EXPLAIN</code> statements are allowed, one at a time, and results are capped at {{ result_limit }} rows.</p>

    <form method="post">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <div class="field">
        <div class="control">
          <textarea name="query" class="textarea" rows="6" placeholder="SELECT * FROM foodbank WHERE slug = 'lambeth-croydon'" spellcheck="false">{{ query }}</textarea>
        </div>
      </div>
      <div class="field">
        <div class="control">
          <button type="submit" class="button is-link is-light">Run</button>
        </div>
      </div>
    </form>

    {% if error %}
    <div class="notification is-danger is-light">{{ error }}</div>
    {% endif %}

    {% if ran %}
      <h2 class="title is-5">Query plan</h2>
      {{ resultTable(plan_columns, plan_rows) }}

      {% if show_results %}
      <h2 class="title is-5">Results{% if truncated %} (truncated at {{ result_limit }} rows){% endif %}</h2>
      {{ resultTable(result_columns, result_rows) }}
      {% endif %}
    {% endif %}
  </div>
</div>
{% endblock %}
