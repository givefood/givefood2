{% extends "admin/page.njk" %}

{% block title %}Settings{% endblock %}

{% block body %}
<h2>Settings</h2>

<div class="columns">
  <div class="column">

    <ul class="settings">
      <li><span class="mdi mdi-food"></span> <a href="/admin/items/">Order Items</a></li>
      <li><span class="mdi mdi-snail"></span> <a href="/admin/slug-redirects/">Slug Redirects</a></li>
      <li><span class="mdi mdi-tag"></span> <a href="/admin/order-groups/">Order Groups</a></li>
      <li><span class="mdi mdi-robot"></span> <a href="/admin/crawl-sets/">Crawl Sets</a></li>
    </ul>

    <h3>Stats</h3>
    <ul class="settings">
      <li>
        <span class="mdi mdi-calendar"></span> Dated Stats
        <form action="/admin/stats/quarter/" method="get">
          <input type="date" name="start" value="{{ quarter_start }}" class="input">
          <input type="date" name="end" value="{{ quarter_end }}" class="input">
          <input type="submit" value="Go" class="button is-link is-light">
        </form>
      </li>
      <li><span class="mdi mdi-pencil"></span> <a href="/admin/stats/editing/">Edit Stats</a></li>
      <li><span class="mdi mdi-numeric"></span> <a href="/admin/stats/orders/">Order Stats</a></li>
      <li><span class="mdi mdi-email-outline"></span> <a href="/admin/stats/subscribers/">Subscriber Stats</a></li>
      <li><span class="mdi mdi-chart-bar"></span> <a href="/admin/stats/subscribers/graph/">Subscriber Graph</a></li>
      <li><span class="mdi mdi-food"></span> <a href="/admin/stats/needs/">Need Stats</a></li>
    </ul>

    <h3>User Data</h3>
    <ul class="settings">
      <li><span class="mdi mdi-email-outline"></span> <a href="/admin/subscriptions/">Subscriptions</a></li>
    </ul>

    {# settings.html:48-53's Geo list is the first three items. "Map" is a fourth,
       added for the same reason as "Food Banks without a need" below: the page is
       real (gfadmin/urls/core.py:13 registers admin:map, routes/admin/index.ts ports
       it) but no Django template links it -- a repo-wide grep for `admin:map` under
       gfadmin/templates/ returns nothing -- and an unlinked page may as well not
       exist. #}
    <h3>Geo</h3>
    <ul class="settings">
      <li><span class="mdi mdi-bullhorn"></span> <a href="/admin/politics/">Parliamentary Constituencies</a></li>
      <li><span class="mdi mdi-city-variant"></span> <a href="/admin/places/">Places</a></li>
      <li><span class="mdi mdi-numeric-2"></span> <a href="/admin/foodbanks/dupe_postcodes/">Dupe Food Bank Postcodes</a></li>
      <li><span class="mdi mdi-map"></span> <a href="/admin/map/">Map</a></li>
    </ul>

    {# A section Django's settings page does not have, holding one item of each kind:
        - "Food Banks without a need" IS a Django page (gfadmin/urls/foodbanks.py:10),
          just a direct-URL-only one that no template links. Surfaced, not invented.
        - "Query Console" is port-only: Django has no equivalent view at any URL. See
          workers/site/src/routes/admin/query.ts and PLAN.md WP 6.10, which specifies
          it as POST-only, SELECT/EXPLAIN-only and row-capped. #}
    <h3>Data quality</h3>
    <ul class="settings">
      <li><span class="mdi mdi-basket-off"></span> <a href="/admin/foodbanks/without_need/">Food Banks without a need</a></li>
      <li><span class="mdi mdi-database-search"></span> <a href="/admin/query/">Query Console</a></li>
    </ul>

    {# settings.html:56 shouts this one heading -- "DANGER ZONE" -- where every other
       danger zone in the admin (foodbank.html:290, need.html:142, order.html:102) is
       sentence case. This is the one whose buttons act on the whole site rather than
       one record, so the casing is kept. #}
    <h3><span class="mdi mdi-alert"></span> DANGER ZONE</h3>

    {# routes/admin/clearCache.ts redirects back here with ?cache=<outcome>.
       The route narrows the querystring to this fixed four-value enum before
       it reaches the template. #}
    {% if cache_result == "purged" %}
      <div class="notification is-success is-light">Cache purged.</div>
    {% elif cache_result == "purged-kv-only" %}
      <div class="notification is-warning is-light">
        Cleared the KV fragments, but the CDN cache was <strong>not</strong> purged:
        CF_API_KEY / CF_ZONE_ID are not set on this Worker.
      </div>
    {% elif cache_result == "cooldown" %}
      <div class="notification is-warning is-light">Not purged &mdash; a purge already ran in the last minute.</div>
    {% elif cache_result == "failed" %}
      <div class="notification is-danger is-light">Cloudflare rejected the purge. Check the Worker logs.</div>
    {% endif %}

    <ul class="settings">
      <li>
        <span class="mdi mdi-bag-personal"></span>
        {# Django has this as a plain <a href> GET (settings.html:59). POST here:
           a purge is a mutation, and a link-prefetcher shouldn't be able to
           fire one. See routes/admin/clearCache.ts. #}
        <form action="/admin/clearcache/" method="post" style="display:inline" onsubmit="return confirm('Purge the whole cache?');">
          <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
          <button type="submit" class="button is-danger is-light is-small">Clear Cache</button>
        </form>
      </li>
    </ul>

    {# Django's settings.html also has a "Testers" block (Email / Web Push /
       WhatsApp) and a Credentials link under its own Danger Zone. Neither is
       ported, deliberately:
        - Credentials: gfadmin's /admin/credential/<name>/ returns any secret
          as text/plain. PLAN.md §2.9.1 replaces the whole GfCredential table
          (43 rows) with Worker secrets, so there is no secret store for an
          admin page to read and nothing to port.
        - Testers: send real email / push / WhatsApp messages. They are not
          reachable from Django's nav either beyond this page, and each needs
          a live third-party credential. Left out until there is a reason. #}

  </div>
</div>
{% endblock %}
