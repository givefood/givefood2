{% extends "admin/page.njk" %}

{# need_categorise.html:4 is `{{ need }}`, i.e. FoodbankChange.__str__
   (givefood/models/needs.py:84-85). A constant "Categorise" titled every
   need's page identically, so several open in tabs were indistinguishable.
   Verbatim copy of need.njk:9, including its "Unknown" fallback for a null
   foodbank_name (__str__ would interpolate the literal "None"). #}
{% block title %}{{ need.foodbank_name or "Unknown" }} - {{ need.created|date("M d Y H:i:s") }} ({{ need.need_id_short }}){% endblock %}

{# need_categorise.html:6-18's head style. `.item`'s 400px is Django's own
   value and the width the whole layout is built around. Django's other two
   rules do not carry over: `hr` (this page has none) and `.label {display:
   none}` (nothing here renders bulma field labels).

   NOT FULL WIDTH. Django's forms are `.field` blocks that its inline script
   makes `is-inline-block-desktop`, so each row is item + category sitting
   side by side at their own size, left-aligned, with the rest of the page
   empty. The port's table was `is-fullwidth` with 60%/40% columns, which on
   a 1440px window stretched a "Milk" dropdown to ~570px and left a ~250px
   dead gap mid-row. `width: auto` puts the table back to its content --
   the item box at Django's 400px, the select at its widest option. #}
{% block head %}
  <style>
    .item { width: 400px; }
    /* Beats Bulma's `.table` (width:100% on is-fullwidth) without needing
       !important, since this sheet loads after bulma.min.css. */
    .categorise-table { width: auto; }
    /* Django's rows are two adjacent inline-blocks with no column gutter;
       a table cell needs the gap spelled out or the select butts against
       the item box. */
    .categorise-table td + td, .categorise-table th + th { padding-left: 1.5rem; }
  </style>
{% endblock %}

{% block body %}
<div class="columns">
  {# need_categorise.html:25 -- one column with NO size class, i.e. full page width (Django's
     head style also flows each .field inline across it). The generic-form `is-half` this page
     had picked up left the whole item/category table in the left half of the page. #}
  <div class="column">
    {# need_categorise.html:26 -- {{ need.need_id_short }}, the 7-char id (models/needs.py:81-82),
       as on every other need page. adminNeedCategorise supplies it; the full uuid is only a
       fallback. #}
    <h2>{{ need.need_id_short or need.need_id }}</h2>

    <form action="/admin/need/{{ need.need_id }}/categorise/" method="post">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      {# NeedLineForm (givefood/forms.py:239-247) hides only `type`
         (`self.fields['type'].widget = HiddenInput()`) and leaves `item` as a
         plain TextInput with class "item" -- so Django shows NO Type column
         and one editable 400px box per line, which is how a reviewer fixes a
         misspelling picked up off a food bank's page while categorising it.
         The port had item as static text and `type` promoted to a visible
         column: both wrong way round. `maxlength` is
         FoodbankChangeLine.item's max_length=250 (models/needs.py:366).

         `orig_item_N` carries the text the row was RENDERED with, which is
         the key the row is found by (Django's `prefix=line` +
         `existing_need_lines.get(line)`, views.py:2071-2074); `item_N` is
         what the reviewer may have edited. Both are posted so needs.ts can
         tell a rename from a new line. #}
      {# No is-fullwidth and no percentage column widths: both are what
         stretched this across the window. The item input carries its own
         400px (.item, Django's value), the select sizes to its longest
         option, and the table shrinks to the two of them. #}
      <table class="table categorise-table">
        <thead><tr><th>Item</th><th>Category</th></tr></thead>
        <tbody>
          {% for line in lines %}
          <tr>
            <td><input type="text" class="input item" name="item_{{ loop.index0 }}" value="{{ line.item }}" maxlength="250"></td>
            <td>
              <input type="hidden" name="orig_item_{{ loop.index0 }}" value="{{ line.item }}">
              <input type="hidden" name="type_{{ loop.index0 }}" value="{{ line.type }}">
              {# is-fullwidth REMOVED with the table's own: inside an
                 auto-width table it is circular (the cell sizes to the
                 select, the select to the cell) and it is what made "Milk"
                 570px wide. A bare `.select` sizes to its widest option --
                 "Tinned Vegetables" -- so nothing truncates, which was the
                 original reason for is-fullwidth. #}
              <div class="select">
                <select name="category_{{ loop.index0 }}">
                  <option value="">-- choose --</option>
                  {% for category in categories %}
                  <option value="{{ category }}"{% if category == line.category %} selected{% endif %}>{{ category }}</option>
                  {% endfor %}
                </select>
              </div>
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
      <input type="submit" class="button is-link is-light" value="Submit">
    </form>
  </div>
</div>
{% endblock %}
