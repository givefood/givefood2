{% extends "admin/page.njk" %}

{% block title %}Categorise{% endblock %}

{% block body %}
<div class="columns">
  {# need_categorise.html:25 -- one column with NO size class, i.e. full page width (Django's
     head style also flows each .field inline across it). The generic-form `is-half` this page
     had picked up left the whole item/type/category table in the left half of the page. #}
  <div class="column">
    {# need_categorise.html:26 -- {{ need.need_id_short }}, the 7-char id (models/needs.py:81-82),
       as on every other need page. Falls back to the full uuid until adminNeedCategorise passes
       need_id_short the way adminNeedDetail/adminNeedTranslations already do. #}
    <h2 class="title is-4">{{ need.need_id_short or need.need_id }}</h2>

    <form action="/admin/need/{{ need.need_id }}/categorise/" method="post">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <table class="table is-fullwidth">
        <thead><tr><th>Item</th><th>Type</th><th>Category</th></tr></thead>
        <tbody>
          {% for line in lines %}
          <tr>
            <td>{{ line.item }}</td>
            <td>{{ line.type }}</td>
            <td>
              <input type="hidden" name="item_{{ loop.index0 }}" value="{{ line.item }}">
              <input type="hidden" name="type_{{ loop.index0 }}" value="{{ line.type }}">
              <div class="select is-small">
                <select name="category_{{ loop.index0 }}">
                  <option value="">-- choose --</option>
                  {% for category in categories %}
                  <option value="{{ category }}"{% if category == line.category %} selected{% endif %}>{{ category }}</option>
                  {% endfor %}
                </select>
              </div>
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
      <input type="submit" class="button is-link is-light" value="Submit">
    </form>
  </div>
</div>
{% endblock %}
