{% extends "page.njk" %}

{% block title %}{{ _("404 - Not Found") }} - Give Food{% endblock %}

{% block body %}

  <div class="columns">
    <div class="column">

      <div class="columns">

        <div class="column is-4">
          <a href="{{ url('index') }}" class="logo"><img src="/static/img/logo.svg" alt="Give Food"></a>
        </div>

      </div>

      <h1>{{ _("404 - Not Found") }}</h1>

      <div class="columns">

          <div class="column">

            <p>{{ _("Sorry, we can't find that page. It may have been removed or you might have entered an incorrect URL.") }}</p>

            <ul>
                <li><a href="/">{{ _("Homepage") }}</a></li>
                <li><a href="/needs/">{{ _("Find what food banks need") }}</a></li>
                <li>{{ _("Email") }} <a href="mailto:mail@givefood.org.uk">mail@givefood.org.uk</a></li>
            </ul>

          </div>
      </div>

    </div>
  </div>

{% endblock %}
