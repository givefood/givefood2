{% extends "page.njk" %}

{% block head %}
  <link rel="stylesheet" href="/static/css/wfbn.css?v={{ version }}">
  {% if foodbank.latest_need_change_text != "Unknown" and foodbank.latest_need_change_text != "Nothing" %}
    <link rel="alternate" type="application/rss+xml" title="RSS feed for {{ full_name }}" href="{{ url('wfbn:foodbank_rss', foodbank.slug) }}">
  {% endif %}
  <link rel="alternate" type="text/markdown" href="{{ url('wfbn-md:md_foodbank_location', foodbank.slug, location.slug) }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="@GiveFoodCharity">
  <meta property="og:title" content="{{ location.name }}, {{ full_name }}">
  <meta property="og:description" content="Find what {{ full_name }} in {{ location.name }} is requesting to have donated">
  <meta name="description" content="Find what {{ full_name }} in {{ location.name }} is requesting to have donated">
  <meta property="og:image" content="https://www.givefood.org.uk{{ location_map_url }}">
  <meta name="geo.placename" content="{{ location.name }} - {{ full_name }}">
  <meta name="geo.position" content="{{ location.lat_lng }}">
  <meta property="place:location:latitude" content="{{ location.latitude }}">
  <meta property="place:location:longitude" content="{{ location.longitude }}">
  {% if foodbank.is_closed %}
    <meta name="robots" content="noindex">
  {% endif %}
  <script type="application/ld+json">
  {{ location.schema_org_str|safe }}
  </script>
{% endblock %}

{% block title %}{{ location.name }} - {{ full_name }} - Give Food{% endblock %}

{% block body %}

  <div class="columns">
    <div class="column">

      <div class="columns">
        <div class="column">
          <a href="{{ url('index') }}" class="logo"><img src="/static/img/logo.svg" alt="Give Food"></a>
          {% include "includes/langswitcher.njk" %}
        </div>
      </div>

      <nav class="breadcrumb has-arrow-separator" aria-label="breadcrumbs">
        <ul>
          <li><a href="{{ url('index') }}">{% blocktrans %}Home{% endblocktrans %}</a></li>
          <li><a href="{{ url('wfbn:foodbank', foodbank.slug) }}">{{ full_name }}</a></li>
          <li class="is-active"><a href="#" aria-current="page">{{ location.name }}</a></li>
        </ul>
      </nav>

      {% set prefix = location.name %}
      {% include "wfbn/foodbank/includes/pagetitle.njk" %}

      <div class="columns">

          <div class="column is-2 menu-col">
            {% include "wfbn/foodbank/includes/menu.njk" %}
          </div>

          <div class="column">

            {% if foodbank.is_closed %}
              <p class="tag is-danger is-large">{% blocktrans %}This food bank is closed{% endblocktrans %}</p>
            {% endif %}

            {% if foodbank.latest_need_change_text != "Unknown" and foodbank.latest_need_change_text != "Nothing" %}
              {% if foodbank.latest_need_get_change_text == "Facebook" %}
                <p>You can find out what {{ full_name }} is requesting to have donated on their Facebook page:</p>
                {% set page_name = foodbank.facebook_page %}{% include "wfbn/includes/facebook_embed.njk" %}
              {% else %}
                <p>{{ full_name }} {% blocktrans %}is currently requesting the following items to be donated:{% endblocktrans %}</p>
                <p class="needs">
                  {% set need_text = foodbank.latest_need_get_change_text %}{% include "wfbn/includes/need_text.njk" %}
                </p>
                {% if foodbank.latest_need_excess_text %}
                  <p>{% blocktrans %}They don't need any more{% endblocktrans %} {% for item in excess_text_list %}{{ item }}{% if not loop.last %}, {% endif %}{% endfor %}.</p>
                {% endif %}

                {% if location.is_donation_point %}
                  <p>🛒 {% blocktrans %}This location accepts donations{% endblocktrans %}</p>
                {% endif %}
                {% if location.is_mobile %}
                  <p>🚚 {% blocktrans %}Mobile food bank location{% endblocktrans %}</p>
                {% endif %}

                {% include "wfbn/foodbank/includes/subscribe.njk" %}
              {% endif %}
            {% else %}
              {% if location.is_donation_point %}
                <p>🛒 {% blocktrans %}This location accepts donations{% endblocktrans %}</p>
              {% endif %}
              {% if location.is_mobile %}
                <p>🚚 {% blocktrans %}Mobile food bank location{% endblocktrans %}</p>
              {% endif %}

              <div class="contacts">
                <a href="{{ url_with_ref }}" class="website">{{ foodbank.url|friendly_url|truncatechars(40) }}</a>
                {% if foodbank.phone_number %}
                  <a href="tel:{{ location.phone_or_foodbank_phone|full_phone }}" class="phone">{{ location.phone_or_foodbank_phone|friendly_phone }}</a>
                {% endif %}
                <a href="mailto:{{ location.email_or_foodbank_email }}" class="email">{{ location.email_or_foodbank_email|truncatechars(40) }}</a>
              </div>

              {% include "wfbn/foodbank/includes/charitynetwork.njk" %}
            {% endif %}

          </div>

          <div class="column{% if foodbank.latest_need_change_text == "Unknown" or foodbank.latest_need_change_text == "Nothing" %} is-7{% endif %}">

            {% include "wfbn/foodbank/includes/ctas.njk" %}

            {% if location.place_has_photo and not location.boundary_geojson %}
              <div>
                <picture>
                  <source srcset="/cdn-cgi/image/format=avif,width=540{{ url('wfbn-generic:foodbank_location_photo', foodbank.slug, location.slug) }} 540w, /cdn-cgi/image/format=avif,width=1080{{ url('wfbn-generic:foodbank_location_photo', foodbank.slug, location.slug) }} 1080w" type="image/avif" sizes="(max-width: 540px) 540px, 1080px">
                  <source srcset="/cdn-cgi/image/format=webp,width=540{{ url('wfbn-generic:foodbank_location_photo', foodbank.slug, location.slug) }} 540w, /cdn-cgi/image/format=webp,width=1080{{ url('wfbn-generic:foodbank_location_photo', foodbank.slug, location.slug) }} 1080w" type="image/webp" sizes="(max-width: 540px) 540px, 1080px">
                  <img src="/cdn-cgi/image/width=1080{{ url('wfbn-generic:foodbank_location_photo', foodbank.slug, location.slug) }}" alt="{{ location.name }}" loading="lazy" class="placephoto">
                </picture>
              </div>
            {% endif %}

            <div id="map" class="sidemap"></div>
            {% set show_service_area = true %}{% include "includes/maplegend.njk" %}
            {% if foodbank.latest_need_change_text != "Unknown" and foodbank.latest_need_change_text != "Nothing" %}
              {% include "includes/serviceareadisclaimer.njk" %}
            {% endif %}

            {% if location.address or location.postcode %}
              <a href="https://www.google.com/maps?saddr=My+Location&daddr={{ location.lat_lng }}" class="{% if language_direction == 'ltr' %}is-pulled-right{% else %}is-pulled-left{% endif %} button is-info is-small is-light directions-btn">{% blocktrans %}Directions{% endblocktrans %}</a>
              <address>
                {% if location.address %}{{ location.address|linebreaksbr }}{% endif %}{% if location.address and location.postcode %}<br>{% endif %}{% if location.postcode %}{{ location.postcode }}{% endif %}
              </address>
              <div class="pluscode">
                <a href="https://www.google.co.uk/maps/place/{{ location.plus_code_global|urlencode }}/" class="pluscode">{{ location.plus_code_global }}</a>
              </div>
            {% endif %}

            {% if foodbank.delivery_address %}
              <h3>{% blocktrans %}Delivery{% endblocktrans %}</h3>
              {% if foodbank.latest_need_change_text != "Unknown" and foodbank.latest_need_change_text != "Nothing" %}
                <a href="https://www.google.com/maps?saddr=My+Location&daddr={{ foodbank.delivery_lat_lng }}" class="{% if language_direction == 'ltr' %}is-pulled-right{% else %}is-pulled-left{% endif %} button is-info is-small is-light directions-btn">{% blocktrans %}Directions{% endblocktrans %}</a>
              {% endif %}
              <address>
                {{ foodbank.delivery_address|linebreaksbr }}
              </address>
            {% endif %}

            {% if foodbank.latest_need_change_text != "Unknown" and foodbank.latest_need_change_text != "Nothing" %}
              <div class="contacts">
                <a href="{{ url_with_ref }}" class="website">{{ foodbank.url|friendly_url|truncatechars(40) }}</a>
                {% if foodbank.phone_number %}
                  <a href="tel:{{ location.phone_or_foodbank_phone|full_phone }}" class="phone">{{ location.phone_or_foodbank_phone|friendly_phone }}</a>
                {% endif %}
                <a href="mailto:{{ location.email_or_foodbank_email }}" class="email">{{ location.email_or_foodbank_email|truncatechars(40) }}</a>
              </div>

              {% include "wfbn/foodbank/includes/charitynetwork.njk" %}
            {% endif %}

          </div>
      </div>

    </div>
  </div>

{% endblock %}

{% block script %}
  {% include "includes/mapconfig.njk" %}
  <script src="/static/js/wfbn.js?v={{ version }}" defer onload="init()"></script>
  {% set slug = foodbank.slug %}{% include "wfbn/includes/hit.njk" %}
{% endblock %}
