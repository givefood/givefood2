{% extends "page.njk" %}

{% block head %}
  <link rel="stylesheet" href="/static/css/wfbn.css?v={{ version }}">
  {% if foodbank.latest_need_change_text != "Unknown" and foodbank.latest_need_change_text != "Nothing" %}
    <link rel="alternate" type="application/rss+xml" title="RSS feed for {{ full_name }}" href="{{ url('wfbn:foodbank_rss', foodbank.slug) }}">
  {% endif %}
  <link rel="alternate" type="application/json" href="{{ url('api2:foodbank', foodbank.slug) }}">
  <link rel="alternate" type="application/xml" href="{{ url('api2:foodbank', foodbank.slug) }}?format=xml">
  <link rel="alternate" type="application/yaml" href="{{ url('api2:foodbank', foodbank.slug) }}?format=yaml">
  <link rel="alternate" type="text/markdown" href="{{ url('wfbn-md:md_foodbank', foodbank.slug) }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="@GiveFoodCharity">
  <meta property="og:title" content="{{ full_name }}">
  <meta property="og:description" content="Find what {{ full_name }} is requesting to have donated">
  <meta name="description" content="Find what {{ full_name }} is requesting to have donated">
  <meta property="og:image" content="https://www.givefood.org.uk{{ url('wfbn:foodbank_map', foodbank.slug) }}">
  <meta property="og:image:alt" content="Map of {{ full_name }}">
  <meta name="geo.placename" content="{{ full_name }}">
  <meta name="geo.position" content="{{ foodbank.lat_lng }}">
  <meta property="place:location:latitude" content="{{ latt }}">
  <meta property="place:location:longitude" content="{{ long }}">
  {% if foodbank.is_closed %}
    <meta name="robots" content="noindex">
  {% endif %}
  <script type="application/ld+json">
  {{ schema_org_str|safe }}
  </script>
{% endblock %}

{% block title %}{{ full_name }} - Give Food{% endblock %}

{% block body %}

  <div class="columns">
    <div class="column">

      <div class="columns">
        <div class="column">
          <a href="{{ url('index') }}" class="logo"><img src="/static/img/logo.svg" alt="Give Food"></a>
          {% include "includes/langswitcher.njk" %}
        </div>
      </div>

      <nav class="breadcrumb has-arrow-separator" aria-label="breadcrumbs">
            <ul>
                <li><a href="{{ url('index') }}">{% blocktrans %}Home{% endblocktrans %}</a></li>
                <li class="is-active"><a href="#" aria-current="page">{{ full_name }}</a></li>
            </ul>
      </nav>

      {% include "wfbn/foodbank/includes/pagetitle.njk" %}

      <div class="columns">

          <div class="column is-2 menu-col">
            {% include "wfbn/foodbank/includes/menu.njk" %}
          </div>

          <div class="column">

            {% if foodbank.is_closed %}
              <p class="tag is-danger is-large">{% blocktrans %}This food bank is closed{% endblocktrans %}</p>
            {% endif %}

            {% if foodbank.latest_need_change_text != "Unknown" and foodbank.latest_need_change_text != "Nothing" %}
              {% if foodbank.latest_need_get_change_text == "Facebook" %}
                <p>{% blocktrans %}You can find out what is needed on the foodbank's Facebook page:{% endblocktrans %}</p>
                {% set page_name = foodbank.facebook_page %}{% include "wfbn/includes/facebook_embed.njk" %}
              {% else %}
                <p>{{ full_name }} {% blocktrans %}is currently requesting the following items to be donated:{% endblocktrans %}</p>
                <p class="needs">
                  {% set need_text = foodbank.latest_need_get_change_text %}{% include "wfbn/includes/need_text.njk" %}
                </p>
                {% if foodbank.latest_need_excess_text %}
                  <p>{% blocktrans %}They don't need any more{% endblocktrans %} {% for item in excess_text_list %}{{ item }}{% if not loop.last %}, {% endif %}{% endfor %}.</p>
                {% endif %}

                {% include "wfbn/foodbank/includes/subscribe.njk" %}
              {% endif %}
            {% else %}
              <div class="contacts">
                <a href="{{ url_with_ref }}" class="website">{{ foodbank.url|friendly_url|truncatechars(40) }}</a>
                {% if foodbank.phone_number %}
                  <a href="tel:{{ foodbank.phone_number|full_phone }}" class="phone">{{ foodbank.phone_number|friendly_phone }}</a>
                  {% if foodbank.secondary_phone_number %}<a href="tel:{{ foodbank.secondary_phone_number|full_phone }}"  class="phone">{{ foodbank.secondary_phone_number|friendly_phone }}</a>{% endif %}
                {% endif %}
                <a href="mailto:{{ foodbank.contact_email }}" class="email">{{ foodbank.contact_email|truncatechars(40) }}</a>
                {% if foodbank.facebook_page %}
                  <a href="https://www.facebook.com/{{ foodbank.facebook_page }}" class="facebook">{{ foodbank.facebook_page }}</a>
                {% endif %}
              </div>
            {% endif %}

            {% if foodbank.is_school %}
              {% if foodbank.latest_need_change_text != "Unknown" and foodbank.latest_need_change_text != "Nothing" %}
                <p>🏫 {% blocktrans %}This food bank is located at a school, so may not be open to the public.{% endblocktrans %}</p>
              {% else %}
                <br><p>🏫 {% blocktrans %}This food bank is located at a school, so may not be open to the public.{% endblocktrans %}</p>
              {% endif %}
            {% endif %}

            {% if foodbank.latest_need_change_text == "Unknown" or foodbank.latest_need_change_text == "Nothing" %}
              {% include "wfbn/foodbank/includes/charitynetwork.njk" %}
              {% include "wfbn/foodbank/includes/fsa.njk" %}
            {% endif %}

          </div>

          <div class="column{% if foodbank.latest_need_change_text == "Unknown" or foodbank.latest_need_change_text == "Nothing" %} is-6{% endif %}">

            {% include "wfbn/foodbank/includes/ctas.njk" %}

            <div id="map" class="sidemap"></div>
            {% set show_service_area = true %}{% include "includes/maplegend.njk" %}
            {% if foodbank.latest_need_change_text == "Unknown" or foodbank.latest_need_change_text == "Nothing" %}
            {% else %}
              {% include "includes/serviceareadisclaimer.njk" %}
            {% endif %}

            {% if foodbank.place_has_photo and not foodbank.address_is_administrative %}
              <div>
                <picture>
                  {% if foodbank.latest_need_change_text == "Unknown" or foodbank.latest_need_change_text == "Nothing" %}
                    <source type="image/avif" srcset="https://www.givefood.org.uk/cdn-cgi/image/width=540,format=avif{{ url('wfbn-generic:foodbank_photo', foodbank.slug) }} 540w, https://www.givefood.org.uk/cdn-cgi/image/width=1080,format=avif{{ url('wfbn-generic:foodbank_photo', foodbank.slug) }} 1080w" sizes="(max-width: 540px) 540px, 1080px">
                    <source type="image/webp" srcset="https://www.givefood.org.uk/cdn-cgi/image/width=540,format=webp{{ url('wfbn-generic:foodbank_photo', foodbank.slug) }} 540w, https://www.givefood.org.uk/cdn-cgi/image/width=1080,format=webp{{ url('wfbn-generic:foodbank_photo', foodbank.slug) }} 1080w" sizes="(max-width: 540px) 540px, 1080px">
                    <img src="{{ url('wfbn-generic:foodbank_photo', foodbank.slug) }}" alt="{{ foodbank.name }}" loading="lazy" class="placephoto">
                  {% else %}
                    <source srcset="https://www.givefood.org.uk/cdn-cgi/image/width=540,format=avif{{ url('wfbn-generic:foodbank_photo', foodbank.slug) }} 540w,https://www.givefood.org.uk/cdn-cgi/image/width=1080,format=avif{{ url('wfbn-generic:foodbank_photo', foodbank.slug) }} 1080w" type="image/avif" sizes="(max-width: 540px) 540px, 1080px">
                    <source srcset="https://www.givefood.org.uk/cdn-cgi/image/width=540,format=webp{{ url('wfbn-generic:foodbank_photo', foodbank.slug) }} 540w,https://www.givefood.org.uk/cdn-cgi/image/width=1080,format=webp{{ url('wfbn-generic:foodbank_photo', foodbank.slug) }} 1080w" type="image/webp" sizes="(max-width: 540px) 540px, 1080px">
                    <img src="https://www.givefood.org.uk/cdn-cgi/image/width=540{{ url('wfbn-generic:foodbank_photo', foodbank.slug) }}" alt="{{ foodbank.name }}" loading="lazy" class="placephoto">
                  {% endif %}
                </picture>
              </div>
            {% endif %}

            {% if foodbank.address_is_administrative %}
              <h3>{% blocktrans %}Administrative{% endblocktrans %}</h3>
            {% else %}
              <a href="https://www.google.com/maps?saddr=My+Location&daddr={{ foodbank.lat_lng }}" class="{% if language_direction == 'ltr' %}is-pulled-right{% else %}is-pulled-left{% endif %} button is-info is-small is-light directions-btn">{% blocktrans %}Directions{% endblocktrans %}</a>
            {% endif %}
            <address>
              {{ foodbank.address|linebreaksbr }}<br>
              {{ foodbank.postcode }}<br>
              {% set country = foodbank.country %}{% include "includes/country.njk" %}
            </address>
            <div class="pluscode">
              <a href="https://www.google.co.uk/maps/place/{{ foodbank.plus_code_global|urlencode }}/" class="pluscode">{{ foodbank.plus_code_global }}</a>
            </div>

            {% if foodbank.delivery_address %}
              <h3>{% blocktrans %}Delivery{% endblocktrans %}</h3>
              <a href="https://www.google.com/maps?saddr=My+Location&daddr={{ foodbank.delivery_lat_lng }}" class="{% if language_direction == 'ltr' %}is-pulled-right{% else %}is-pulled-left{% endif %} button is-info is-small is-light directions-btn">{% blocktrans %}Directions{% endblocktrans %}</a>
              <address>
                {{ foodbank.delivery_address|linebreaksbr }}
              </address>
            {% endif %}

            {% if foodbank.latest_need_change_text != "Unknown" and foodbank.latest_need_change_text != "Nothing" %}
              <div class="contacts">
                <a href="{{ url_with_ref }}" class="website">{{ foodbank.url|friendly_url|truncatechars(40) }}</a>
                {% if foodbank.phone_number %}
                  <a href="tel:{{ foodbank.phone_number|full_phone }}" class="phone">{{ foodbank.phone_number|friendly_phone }}</a>
                  {% if foodbank.secondary_phone_number %}<a href="tel:{{ foodbank.secondary_phone_number|full_phone }}"  class="phone">{{ foodbank.secondary_phone_number|friendly_phone }}</a>{% endif %}
                {% endif %}
                <a href="mailto:{{ foodbank.contact_email }}" class="email">{{ foodbank.contact_email|truncatechars(40) }}</a>
                {% if foodbank.facebook_page %}
                  <a href="https://www.facebook.com/{{ foodbank.facebook_page }}" class="facebook">{{ foodbank.facebook_page }}</a>
                {% endif %}
              </div>

              {% include "wfbn/foodbank/includes/charitynetwork.njk" %}
              {% include "wfbn/foodbank/includes/fsa.njk" %}
            {% endif %}

          </div>
      </div>

    </div>
  </div>

{% endblock %}

{% block script %}
  {% include "includes/mapconfig.njk" %}
  <script src="/static/js/wfbn.js?v={{ version }}" defer onload="init()"></script>
  {% set slug = foodbank.slug %}{% include "wfbn/includes/hit.njk" %}
{% endblock %}
